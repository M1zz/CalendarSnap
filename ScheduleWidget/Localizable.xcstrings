    "달력을 찍어\n일정을 등록하세요": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender fotografieren,\nTermine eintragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap a calendar\nto add events"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap a calendar\nto add events"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una foto al calendario\ny añade los eventos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez un calendrier\npour ajouter des événements"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografa un calendario\nper aggiungere gli eventi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーを撮影して\n予定を登録しましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력을 찍어\n일정을 등록하세요"
