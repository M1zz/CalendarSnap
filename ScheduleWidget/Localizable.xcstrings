{
  "sourceLanguage": "ko",
  "strings": {
    "다가오는 일정": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다가오는 일정"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即将到来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即將到來"
          }
        }
      }
    },
    "달력을 찍어\n일정을 등록하세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap a calendar\nto add events"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap a calendar\nto add events"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력을 찍어\n일정을 등록하세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍下日历\n添加日程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍下行事曆\n新增行程"
          }
        }
      }
    },
    "아이 일정": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kids’ Schedule"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Kids’ Schedule"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이 일정"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子日程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子行程"
          }
        }
      }
    },
    "어린이집 달력에서 추출한 다가오는 일정을 보여줍니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows upcoming events pulled from a daycare calendar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows upcoming events pulled from a nursery calendar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어린이집 달력에서 추출한 다가오는 일정을 보여줍니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示从幼儿园日历中提取的近期日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示從幼兒園行事曆擷取的近期行程。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
