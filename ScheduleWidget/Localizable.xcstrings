    "어린이집 달력에서 추출한 다가오는 일정을 보여줍니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje nadcházející události vyčtené z kalendáře školky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kommende begivenheder udtrukket fra en kalender fra børnehaven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt anstehende Termine, die aus einem Kita-Kalender ausgelesen wurden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει τα επερχόμενα συμβάντα που εξήχθησαν από ένα ημερολόγιο παιδικού σταθμού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows upcoming events pulled from a daycare calendar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows upcoming events pulled from a nursery calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los próximos eventos extraídos del calendario de la guardería."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää päiväkodin kalenterista poimitut tulevat tapahtumat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les prochains événements extraits d’un calendrier de crèche."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan acara mendatang yang diambil dari kalender sekolah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i prossimi eventi estratti da un calendario del nido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保育園のカレンダーから読み取った今後の予定を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어린이집 달력에서 추출한 다가오는 일정을 보여줍니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kommende avtaler hentet fra en barnehagekalender."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont aankomende afspraken uit een agenda van de opvang."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os próximos eventos extraídos do calendário da escolinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает ближайшие события из календаря детского сада."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงกำหนดการที่กำลังจะถึงซึ่งดึงมาจากปฏิทินของโรงเรียน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các sự kiện sắp tới được trích xuất từ lịch của trường mầm non."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示从幼儿园日历中提取的近期日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示從幼兒園行事曆擷取的近期行程。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
