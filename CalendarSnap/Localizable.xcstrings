    },
    "iCloud에 로그인해야 가족 공유를 쓸 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to use Family Sharing."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to use Family Sharing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud para usar Compartir en familia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家族共有を使うには、iCloudにサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인해야 가족 공유를 쓸 수 있어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы пользоваться семейным доступом, войдите в iCloud."
