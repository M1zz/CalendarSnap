    "공유 정보가 초기화됐어요. 다시 초대해주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Údaje o sdílení byly obnoveny. Pošlete pozvánku znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Delingsoplysningerne er nulstillet. Send invitationen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Freigabeinformationen wurden zurückgesetzt. Bitte lade erneut ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι πληροφορίες κοινής χρήσης επαναφέρθηκαν. Στείλτε ξανά πρόσκληση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing info was reset. Please send an invitation again."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing info was reset. Please send an invitation again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha restablecido la información de compartición. Envía la invitación de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jakotiedot nollattiin. Lähetä kutsu uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de partage ont été réinitialisées. Envoyez à nouveau une invitation."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Info berbagi telah direset. Kirim undangan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le informazioni di condivisione sono state reimpostate. Invia di nuovo l’invito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有情報がリセットされました。もう一度招待してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 정보가 초기화됐어요. 다시 초대해주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Delingsinformasjonen er tilbakestilt. Send invitasjonen på nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De deelgegevens zijn gereset. Stuur de uitnodiging opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacje o udostępnianiu zostały zresetowane. Wyślij zaproszenie ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações de compartilhamento foram redefinidas. Envie o convite novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные общего доступа сброшены. Отправьте приглашение ещё раз."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delningsinformationen har återställts. Skicka inbjudan igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รีเซ็ตข้อมูลการแชร์แล้ว โปรดส่งคำเชิญอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım bilgileri sıfırlandı. Lütfen daveti yeniden gönderin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin chia sẻ đã được đặt lại. Vui lòng gửi lời mời lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享信息已重置，请重新发送邀请。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享資訊已重置，請重新傳送邀請。"
          }
        }
      }
    },
