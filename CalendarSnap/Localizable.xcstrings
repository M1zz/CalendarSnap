    "iCloud 상태를 확인하지 못했어요. 잠시 후 다시 시도해주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav iCloudu se nepodařilo zjistit. Zkuste to za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-status kunne ikke tjekkes. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der iCloud-Status konnte nicht geprüft werden. Versuche es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατός ο έλεγχος της κατάστασης του iCloud. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check iCloud status. Please try again in a moment."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check iCloud status. Please try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comprobar el estado de iCloud. Inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudin tilaa ei voitu tarkistaa. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier l’état d’iCloud. Réessayez dans un instant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status iCloud tidak dapat diperiksa. Coba lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare lo stato di iCloud. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudの状態を確認できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 상태를 확인하지 못했어요. 잠시 후 다시 시도해주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke sjekke iCloud-status. Prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De iCloud-status kon niet worden gecontroleerd. Probeer het zo meteen opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się sprawdzić stanu iCloud. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o status do iCloud. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить состояние iCloud. Повторите попытку чуть позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att kontrollera iCloud-status. Försök igen om en stund."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบสถานะ iCloud ไม่สำเร็จ โปรดลองใหม่อีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud durumu denetlenemedi. Lütfen biraz sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kiểm tra trạng thái iCloud. Vui lòng thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认 iCloud 状态，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認 iCloud 狀態，請稍後再試。"
          }
        }
      }
    },
    "iCloud 저장 공간이 부족해 일정을 올리지 못했어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V iCloudu není dost místa pro nahrání událostí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke nok iCloud-plads til at uploade begivenhederne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug iCloud-Speicher, um die Termine hochzuladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει αρκετός χώρος στο iCloud για να ανεβούν τα συμβάντα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough iCloud storage to upload your events."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough iCloud storage to upload your events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio suficiente en iCloud para subir los eventos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudissa ei ole tarpeeksi tilaa tapahtumien lataamiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace iCloud insuffisant pour envoyer vos événements."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan iCloud tidak cukup untuk mengunggah acara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio iCloud insufficiente per caricare gli eventi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudの空き容量が足りず、予定をアップロードできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 저장 공간이 부족해 일정을 올리지 못했어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke nok iCloud-lagring til å laste opp avtalene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niet genoeg iCloud-opslag om de afspraken te uploaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W iCloud brakuje miejsca na przesłanie wydarzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço suficiente no iCloud para enviar os eventos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В iCloud не хватает места, чтобы загрузить события."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inte tillräckligt med iCloud-utrymme för att ladda upp händelserna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นที่ iCloud ไม่พอสำหรับอัปโหลดกำหนดการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlikleri yüklemek için iCloud’da yeterli alan yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đủ dung lượng iCloud để tải sự kiện lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 存储空间不足，无法上传日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 儲存空間不足，無法上傳行程。"
          }
        }
      }
    },
    "iCloud에 로그인해야 가족 공유를 쓸 수 있어요.": {
      "localizations": {
        "cs": {
