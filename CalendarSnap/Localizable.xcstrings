    "어두운 화면에서도 달력과 일정이 또렷하게 보여요.": {
      "comment": "Roadmap item detail: dark mode",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendář i události zůstanou v tmavém režimu ostré a čitelné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender og begivenheder forbliver skarpe og læsbare i mørk tilstand."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender und Termine bleiben im Dunkelmodus klar und gut lesbar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το ημερολόγιο και τα συμβάντα παραμένουν καθαρά και ευανάγνωστα στον σκούρο τρόπο λειτουργίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calendar and events stay crisp and readable in Dark Mode."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The calendar and events stay crisp and readable in Dark Mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario y los eventos se ven nítidos y legibles en el modo oscuro."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenteri ja tapahtumat pysyvät terävinä ja luettavina tummassa tilassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier et les événements restent nets et lisibles en mode sombre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender dan acara tetap jelas dan mudah dibaca di Mode Gelap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendario ed eventi restano nitidi e leggibili in modalità scura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗い画面でも、カレンダーと予定がくっきり見えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두운 화면에서도 달력과 일정이 또렷하게 보여요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderen og avtalene forblir skarpe og lesbare i mørk modus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De agenda en afspraken blijven scherp en leesbaar in de donkere modus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendarz i wydarzenia pozostają wyraźne i czytelne w trybie ciemnym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário e os eventos continuam nítidos e legíveis no modo escuro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В тёмной теме календарь и события остаются чёткими и читаемыми."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendern och händelserna förblir skarpa och läsbara i mörkt läge."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิทินและกำหนดการยังคมชัดอ่านง่ายในโหมดมืด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim ve etkinlikler Koyu Mod’da net ve okunaklı kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch và sự kiện vẫn rõ nét, dễ đọc trong chế độ tối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色模式下，日历和日程依然清晰易读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深色模式下，行事曆與行程依然清晰易讀。"
          }
        }
      }
    },
    "어린이집 달력에서 추출한 다가오는 일정을 보여줍니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje nadcházející události vyčtené z kalendáře školky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kommende begivenheder udtrukket fra en kalender fra børnehaven."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt anstehende Termine, die aus einem Kita-Kalender ausgelesen wurden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίζει τα επερχόμενα συμβάντα που εξήχθησαν από ένα ημερολόγιο παιδικού σταθμού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows upcoming events pulled from a daycare calendar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows upcoming events pulled from a nursery calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los próximos eventos extraídos del calendario de la guardería."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näyttää päiväkodin kalenterista poimitut tulevat tapahtumat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les prochains événements extraits d’un calendrier de crèche."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan acara mendatang yang diambil dari kalender sekolah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i prossimi eventi estratti da un calendario del nido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保育園のカレンダーから読み取った今後の予定を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어린이집 달력에서 추출한 다가오는 일정을 보여줍니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viser kommende avtaler hentet fra en barnehagekalender."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont aankomende afspraken uit een agenda van de opvang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje nadchodzące wydarzenia wyodrębnione z kalendarza przedszkola."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os próximos eventos extraídos do calendário da escolinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает ближайшие события из календаря детского сада."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar kommande händelser som hämtats från en förskolekalender."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงกำหนดการที่กำลังจะถึงซึ่งดึงมาจากปฏิทินของโรงเรียน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kreş takviminden çıkarılan yaklaşan etkinlikleri gösterir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị các sự kiện sắp tới được trích xuất từ lịch của trường mầm non."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示从幼儿园日历中提取的近期日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示從幼兒園行事曆擷取的近期行程。"
          }
        }
      }
    },
    "어린이집 알림장을 찍거나 문자를 붙여넣어 보세요": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyfoťte oznámení ze školky nebo vložte zprávu"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag et billede af opslaget fra børnehaven, eller indsæt en besked"
          }
