    "반을 입력하면 통신문에서 다른 반 전용 일정을 자동으로 걸러줘요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte třídu a události určené jen pro jiné třídy se automaticky odfiltrují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv en stue for automatisk at filtrere begivenheder fra, der kun gælder for andre stuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib eine Gruppe an, um Termine, die nur für andere Gruppen gelten, automatisch herauszufiltern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εισαγάγετε τμήμα για να φιλτράρονται αυτόματα τα συμβάντα που αφορούν μόνο άλλα τμήματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a class to automatically filter out events meant only for other classes."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a class to automatically filter out events meant only for other classes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica la clase para filtrar automáticamente los eventos que son solo de otras clases."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä ryhmä, niin vain muille ryhmille tarkoitetut tapahtumat suodatetaan automaattisesti pois."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez une classe pour écarter automatiquement les événements réservés à d’autres classes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Isi kelas untuk menyaring otomatis acara yang khusus untuk kelas lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci una sezione per escludere in automatico gli eventi riservati ad altre sezioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラスを入力すると、他のクラス専用の予定が自動で除外されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반을 입력하면 통신문에서 다른 반 전용 일정을 자동으로 걸러줘요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn en avdeling for automatisk å filtrere bort avtaler som bare gjelder andre avdelinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul een groep in om afspraken die alleen voor andere groepen gelden automatisch weg te filteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj grupę, aby automatycznie odfiltrować wydarzenia przeznaczone tylko dla innych grup."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe a turma para filtrar automaticamente os eventos só de outras turmas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите группу, чтобы автоматически убирать события, предназначенные только для других групп."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en avdelning för att automatiskt filtrera bort händelser som bara gäller andra avdelningar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่ชั้นเรียนเพื่อกรองกำหนดการที่เฉพาะชั้นเรียนอื่นออกโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca diğer sınıflara ait etkinlikleri otomatik ayıklamak için bir sınıf girin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập lớp để tự động lọc các sự kiện chỉ dành cho lớp khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写班级后，会自动过滤掉仅属于其他班级的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填寫班級後，會自動過濾掉僅屬於其他班級的行程。"
          }
        }
      }
    },
