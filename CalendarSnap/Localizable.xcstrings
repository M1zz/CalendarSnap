          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre no iCloud para usar o compartilhamento familiar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы пользоваться семейным доступом, войдите в iCloud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på iCloud för att använda familjedelning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าใช้ iCloud เพื่อใช้การแชร์ครอบครัว"
