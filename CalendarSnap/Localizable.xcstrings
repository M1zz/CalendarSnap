        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深色模式下，行事曆與行程依然清晰易讀。"
          }
        }
      }
    },
    "어린이집 달력에서 추출한 다가오는 일정을 보여줍니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows upcoming events pulled from a daycare calendar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows upcoming events pulled from a nursery calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los próximos eventos extraídos del calendario de la guardería."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保育園のカレンダーから読み取った今後の予定を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어린이집 달력에서 추출한 다가오는 일정을 보여줍니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает ближайшие события из календаря детского сада."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示从幼儿园日历中提取的近期日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示從幼兒園行事曆擷取的近期行程。"
          }
        }
      }
    },
    "어린이집 알림장을 찍거나 문자를 붙여넣어 보세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of a daycare notice or paste a message"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo of a nursery notice or paste a message"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una foto del aviso de la guardería o pega un mensaje"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保育園のお知らせを撮影するか、メッセージを貼り付けてみましょう"
