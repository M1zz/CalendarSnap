        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has salido del grupo. Los eventos recibidos hasta ahora se conservan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有から退出しました。これまでに受け取った予定はそのまま残ります。"
