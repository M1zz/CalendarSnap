    "움직임 줄이기를 켜면 화면 효과가 차분해져요.": {
      "comment": "Roadmap item detail: respect Reduce Motion",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Se zapnutým Omezením pohybu jsou efekty na obrazovce klidnější."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Reducer bevægelse slået til bliver skærmeffekterne mere afdæmpede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Bewegung reduzieren“ werden Bildschirmeffekte ruhiger."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Με ενεργή τη Μείωση κίνησης, τα εφέ της οθόνης γίνονται πιο ήρεμα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Reduce Motion on, screen effects calm down."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "With Reduce Motion on, screen effects calm down."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Reducir movimiento activado, los efectos de pantalla son más sutiles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun Vähennä liikettä on päällä, näytön tehosteet rauhoittuvat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec Réduire les animations activé, les effets d’écran se font plus discrets."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan Kurangi Gerakan aktif, efek layar menjadi lebih tenang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con Riduci movimento attivo, gli effetti sullo schermo diventano più sobri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「視差効果を減らす」をオンにすると、画面の動きが控えめになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "움직임 줄이기를 켜면 화면 효과가 차분해져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Reduser bevegelse på blir skjermeffektene roligere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met Beperk beweging aan worden schermeffecten rustiger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu opcji Ogranicz ruch efekty na ekranie stają się spokojniejsze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com Reduzir movimento ativado, os efeitos de tela ficam mais discretos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включить «Уменьшение движения», эффекты на экране станут спокойнее."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med Minska rörelser på blir skärmeffekterna lugnare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิดลดการเคลื่อนไหว เอฟเฟกต์บนหน้าจอจะนุ่มนวลขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hareketi Azalt açıkken ekran efektleri sakinleşir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật Giảm chuyển động, hiệu ứng trên màn hình sẽ dịu hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启“减弱动态效果”后，界面效果会更平静。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「減少動態效果」後，畫面效果會更平靜。"
          }
        }
      }
    },
    "원하면 앱 안에서 저장한 일정을 모두 지울 수 있어요.": {
      "comment": "Roadmap item detail: delete all my data",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smažte všechny uložené události přímo v aplikaci, kdykoli budete chtít."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet alle gemte begivenheder direkte i appen, når du vil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche alle gespeicherten Termine jederzeit direkt in der App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγράψτε όλα τα αποθηκευμένα συμβάντα απευθείας στην εφαρμογή όποτε θέλετε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase all saved events right in the app whenever you want."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase all saved events right in the app whenever you want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra todos los eventos guardados desde la propia app cuando quieras."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista kaikki tallennetut tapahtumat suoraan sovelluksesta milloin haluat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacez tous les événements enregistrés directement dans l’app quand vous le souhaitez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus semua acara tersimpan langsung di aplikasi kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella tutti gli eventi salvati direttamente nell’app quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なときに、アプリ内で保存した予定をすべて削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하면 앱 안에서 저장한 일정을 모두 지울 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slett alle lagrede avtaler rett i appen når du vil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder alle bewaarde afspraken wanneer je wilt, direct in de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń wszystkie zapisane wydarzenia bezpośrednio w aplikacji, kiedy chcesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague todos os eventos salvos direto no app quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В любой момент удалите все сохранённые события прямо в приложении."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
