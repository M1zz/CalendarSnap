    "시간이 지정된 일정에만 적용돼요": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platí jen pro události s určeným časem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gælder kun begivenheder med et fast tidspunkt"
