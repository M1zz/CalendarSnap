    "이미 다른 가족의 공유에 참여하고 있어요. 먼저 ‘공유 나가기’를 한 뒤 초대해주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už jste součástí sdílení jiné rodiny. Nejdřív klepněte na „Opustit sdílení“ a pak pošlete pozvánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er allerede med i en anden families deling. Tryk først på “Forlad deling”, og send derefter en invitation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist bereits Teil einer anderen Familienfreigabe. Tippe zuerst auf „Freigabe verlassen“ und sende dann eine Einladung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συμμετέχετε ήδη στην κοινή χρήση άλλης οικογένειας. Πατήστε πρώτα «Αποχώρηση από την κοινή χρήση» και μετά στείλτε πρόσκληση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re already part of another family’s sharing. Tap “Leave Sharing” first, then send an invitation."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re already part of another family’s sharing. Tap “Leave Sharing” first, then send an invitation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya formas parte del grupo familiar de otra persona. Primero toca «Salir del grupo» y luego envía la invitación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet jo mukana toisen perheen jaossa. Napauta ensin ”Poistu jaosta” ja lähetä sitten kutsu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous participez déjà au partage d’une autre famille. Touchez d’abord « Quitter le partage », puis envoyez une invitation."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah tergabung dalam berbagi keluarga lain. Ketuk “Keluar dari Berbagi” dulu, lalu kirim undangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai già parte della condivisione di un’altra famiglia. Tocca prima «Esci dalla condivisione», poi invia un invito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに別の家族の共有に参加しています。先に「共有から退出」してから招待してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 다른 가족의 공유에 참여하고 있어요. 먼저 ‘공유 나가기’를 한 뒤 초대해주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er allerede med i en annen families deling. Trykk først på «Forlat deling», og send deretter en invitasjon."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je doet al mee aan het delen van een ander gezin. Tik eerst op ‘Stop met delen’ en stuur daarna een uitnodiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uczestniczysz już w udostępnianiu innej rodziny. Najpierw stuknij „Opuść udostępnianie”, a potem wyślij zaproszenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já participa do compartilhamento de outra família. Toque primeiro em “Sair do compartilhamento” e depois envie o convite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уже участвуете в общем доступе другой семьи. Сначала нажмите «Выйти из общего доступа», затем отправьте приглашение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är redan med i en annan familjs delning. Tryck först på ”Lämna delning” och skicka sedan en inbjudan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเข้าร่วมการแชร์ของครอบครัวอื่นอยู่แล้ว แตะ “ออกจากการแชร์” ก่อน แล้วค่อยส่งคำเชิญ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten başka bir ailenin paylaşımına katılıyorsunuz. Önce “Paylaşımdan Ayrıl”a dokunun, ardından davet gönderin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã tham gia nhóm chia sẻ của gia đình khác. Hãy chạm “Rời nhóm chia sẻ” trước rồi mới gửi lời mời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
