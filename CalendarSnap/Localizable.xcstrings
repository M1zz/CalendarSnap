    "내 일정 한 번에 지우기": {
      "comment": "Roadmap item: delete all my data",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smazat všechny moje události"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slet alle mine begivenheder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle meine Termine löschen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαγραφή όλων των συμβάντων μου"
          }
        },
        "en": {
