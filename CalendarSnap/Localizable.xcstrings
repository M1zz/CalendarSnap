    "아이 일정을 파일로 저장하고 다시 불러올 수 있어요.": {
      "comment": "Roadmap item detail: backup and export",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložte rozvrhy dětí do souboru a později je obnovte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem dine børns skema i en fil, og hent det frem igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere die Termine deiner Kinder in einer Datei und hole sie später zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύστε το πρόγραμμα των παιδιών σας σε αρχείο και επαναφέρετέ το αργότερα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your kids’ schedules to a file and bring them back later."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your kids’ schedules to a file and bring them back later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las agendas de tus hijos en un archivo y recupéralas más tarde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallenna lastesi aikataulut tiedostoon ja tuo ne takaisin myöhemmin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez l’agenda de vos enfants dans un fichier et retrouvez-le plus tard."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan jadwal anak Anda ke berkas dan pulihkan nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva l’agenda dei tuoi bambini in un file e recuperala quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さまの予定をファイルに保存して、あとで読み込めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이 일정을 파일로 저장하고 다시 불러올 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre barnas planer i en fil og hent dem tilbake senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar de planning van je kinderen in een bestand en haal die later terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz plan dzieci do pliku i przywróć go później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve a agenda dos seus filhos em um arquivo e recupere quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте расписание детей в файл и возвращайте его позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara barnens scheman i en fil och hämta dem tillbaka senare."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกกำหนดการของลูกเป็นไฟล์ แล้วนำกลับมาใช้ภายหลังได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuklarınızın programını bir dosyaya kaydedin, sonra geri yükleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu lịch của bé vào một tệp và khôi phục lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把孩子的日程保存为文件，以后可以再导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將孩子的行程儲存成檔案，之後可以再匯入。"
          }
        }
      }
    },
