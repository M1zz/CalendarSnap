    "일정 데이터를 가져오지 못했습니다.\n아이일정 앱에서 내보낸 파일인지 확인해주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data rozvrhu se nepodařilo importovat.\nZkontrolujte, zda byl soubor exportován z aplikace Rozvrh školky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalenderdataene kunne ikke importeres.\nTjek, at filen er eksporteret fra appen Børneskema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Termindaten konnten nicht importiert werden.\nPrüfe, ob die Datei aus der App „Kita-Planer“ exportiert wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η εισαγωγή των δεδομένων.\nΕλέγξτε ότι το αρχείο εξήχθη από την εφαρμογή Πρόγραμμα Παιδιού."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t import the schedule data.\nMake sure the file was exported from the Kids Schedule app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t import the schedule data.\nMake sure the file was exported from the Kids Schedule app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron importar los datos de la agenda.\nComprueba que el archivo se exportó desde la app Agenda Peques."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aikataulutietoja ei voitu tuoda.\nTarkista, että tiedosto on viety Lapsen aikataulu -sovelluksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’importer les données du planning.\nVérifiez que le fichier a bien été exporté depuis l’app Agenda Bambin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data jadwal tidak dapat diimpor.\nPastikan berkas tersebut diekspor dari aplikasi Jadwal Si Kecil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile importare i dati dell’agenda.\nVerifica che il file sia stato esportato dall’app Agenda Bimbi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定データを読み込めませんでした。\nこどもスケジュールから書き出したファイルかご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정 데이터를 가져오지 못했습니다.\n아이일정 앱에서 내보낸 파일인지 확인해주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke importere timeplandataene.\nSjekk at filen er eksportert fra appen Barneplan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De plannergegevens konden niet worden geïmporteerd.\nControleer of het bestand is geëxporteerd uit de app Kinderplanner."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zaimportować danych planu.\nSprawdź, czy plik został wyeksportowany z aplikacji Plan Malucha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível importar os dados da agenda.\nConfira se o arquivo foi exportado do app Agenda Kids."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось импортировать данные расписания.\nУбедитесь, что файл экспортирован из приложения «Расписание малыша»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Schemadatan kunde inte importeras.\nKontrollera att filen exporterats från appen Barnschema."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าข้อมูลกำหนดการไม่สำเร็จ\nโปรดตรวจสอบว่าไฟล์นี้ส่งออกจากแอปตารางลูกน้อย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program verileri içe aktarılamadı.\nDosyanın Çocuk Takvimi uygulamasından dışa aktarıldığından emin olun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể nhập dữ liệu lịch.\nHãy kiểm tra xem tệp có được xuất từ ứng dụng Lịch Của Bé không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导入日程数据。\n请确认该文件是从宝贝日程 App 导出的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法匯入行程資料。\n請確認該檔案是從寶貝日程 App 匯出的。"
          }
        }
      }
    },
