    "초대한 가족이 더 이상 일정을 볼 수 없게 됩니다. 지금까지의 일정은 양쪽 기기에 그대로 남아요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozvaní už neuvidí vaše události. Dosavadní události zůstanou na obou zařízeních."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De inviterede kan ikke længere se dine begivenheder. De nuværende begivenheder bliver på begge enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die eingeladenen Personen können deine Termine nicht mehr sehen. Die bisherigen Termine bleiben auf beiden Geräten erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσοι έχετε προσκαλέσει δεν θα βλέπουν πλέον τα συμβάντα σας. Τα υπάρχοντα συμβάντα παραμένουν και στις δύο συσκευές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The people you invited will no longer see your events. Events so far stay on both devices."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The people you invited will no longer see your events. Events so far stay on both devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las personas invitadas dejarán de ver tus eventos. Los eventos de hasta ahora se quedan en ambos dispositivos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutsutut eivät enää näe tapahtumiasi. Nykyiset tapahtumat säilyvät molemmilla laitteilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes invitées ne verront plus vos événements. Les événements actuels restent sur les deux appareils."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang diundang tidak dapat lagi melihat acara Anda. Acara yang ada tetap tersimpan di kedua perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le persone invitate non potranno più vedere i tuoi eventi. Gli eventi attuali restano su entrambi i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待した家族は予定を見られなくなります。これまでの予定は双方のデバイスにそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대한 가족이 더 이상 일정을 볼 수 없게 됩니다. 지금까지의 일정은 양쪽 기기에 그대로 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De inviterte kan ikke lenger se avtalene dine. De nåværende avtalene blir værende på begge enhetene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitgenodigde personen kunnen je afspraken niet meer zien. De huidige afspraken blijven op beide apparaten bestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaproszone osoby nie będą już widzieć Twoich wydarzeń. Dotychczasowe wydarzenia zostają na obu urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pessoas convidadas não poderão mais ver seus eventos. Os eventos atuais continuam nos dois dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглашённые больше не смогут видеть события. Все события останутся на обоих устройствах."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De inbjudna kan inte längre se dina händelser. De nuvarande händelserna finns kvar på båda enheterna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ที่คุณเชิญจะดูกำหนดการของคุณไม่ได้อีก กำหนดการที่มีอยู่จะยังอยู่ในอุปกรณ์ทั้งสองเครื่อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet ettiğiniz kişiler artık etkinliklerinizi göremeyecek. Mevcut etkinlikler iki cihazda da kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những người được mời sẽ không xem được sự kiện của bạn nữa. Các sự kiện hiện có vẫn ở lại trên cả hai thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被邀请的家人将无法再查看日程。目前的日程会保留在双方设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受邀的家人將無法再查看行程。目前的行程會保留在雙方裝置上。"
          }
        }
      }
    },
