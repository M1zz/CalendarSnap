            "state": "translated",
            "value": "Bu gün için etkinlik yok"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày này không có sự kiện"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一天没有日程"
          }
