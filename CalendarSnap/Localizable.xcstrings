        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 프로필이 삭제됩니다. 되돌릴 수 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的资料将被删除，且无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的資料將被刪除，且無法復原。"
          }
        }
      }
    },
