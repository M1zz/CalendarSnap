    "달력을 찍어\n일정을 등록하세요": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyfoťte kalendář\na přidejte události"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag et billede af en kalender\nfor at tilføje begivenheder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender fotografieren,\nTermine eintragen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φωτογραφίστε ένα ημερολόγιο\nγια να προσθέσετε συμβάντα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap a calendar\nto add events"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap a calendar\nto add events"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una foto al calendario\ny añade los eventos"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota kuva kalenterista\nlisätäksesi tapahtumat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez un calendrier\npour ajouter des événements"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto kalender\nuntuk menambah acara"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografa un calendario\nper aggiungere gli eventi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーを撮影して\n予定を登録しましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력을 찍어\n일정을 등록하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bilde av en kalender\nfor å legge til avtaler"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografeer een agenda\nom afspraken toe te voegen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrób zdjęcie kalendarza,\naby dodać wydarzenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografe um calendário\npara adicionar eventos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сфотографируйте календарь,\nчтобы добавить события"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fota en kalender\nför att lägga till händelser"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถ่ายรูปปฏิทิน\nเพื่อเพิ่มกำหนดการ"
          }
        },
