          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " (%lld already saved, skipped)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " (%lld already saved, skipped)"
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " (이미 있는 %lld개 제외)"
          }
        }
      }
    },
    " (중복 %lld개 제외)": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": " (%lld duplicate skipped)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": " (%lld duplicates skipped)"
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " (중복 %lld개 제외)"
