            "state": "translated",
            "value": "日付を選ぶと予定が表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜를 선택하면 일정이 표시됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en dato for å se avtalene"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een datum om de afspraken te zien"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
