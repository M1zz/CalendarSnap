    "공유에서 나왔어요. 지금까지 받은 일정은 그대로 남아 있어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opustili jste sdílení. Dosud přijaté události zůstávají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har forladt delingen. Begivenheder, du allerede har modtaget, bliver liggende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Freigabe verlassen. Bereits erhaltene Termine bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποχωρήσατε από την κοινή χρήση. Τα συμβάντα που έχετε ήδη λάβει παραμένουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve left sharing. Events you’ve received so far stay as they are."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve left sharing. Events you’ve received so far stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has salido del grupo. Los eventos recibidos hasta ahora se conservan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistuit jaosta. Jo vastaanotetut tapahtumat säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez quitté le partage. Les événements déjà reçus sont conservés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah keluar dari berbagi. Acara yang sudah diterima tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei uscito dalla condivisione. Gli eventi già ricevuti restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有から退出しました。これまでに受け取った予定はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유에서 나왔어요. 지금까지 받은 일정은 그대로 남아 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har forlatt delingen. Avtaler du allerede har mottatt, blir værende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent uit het delen gestapt. Afspraken die je al hebt ontvangen, blijven bestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opuszczono udostępnianie. Dotychczas otrzymane wydarzenia zostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você saiu do compartilhamento. Os eventos já recebidos continuam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы вышли из общего доступа. Полученные события остаются на месте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har lämnat delningen. Händelser du redan fått finns kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกจากการแชร์แล้ว กำหนดการที่ได้รับมาแล้วจะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşımdan ayrıldınız. Şimdiye kadar aldığınız etkinlikler olduğu gibi kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã rời nhóm chia sẻ. Các sự kiện đã nhận vẫn được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已退出共享。目前收到的日程会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已退出共享。目前收到的行程會保留。"
          }
        }
      }
    },
    "공유할 일정이 없어요.": {
      "localizations": {
        "cs": {
