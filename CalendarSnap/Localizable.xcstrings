    "대비를 높이거나 색을 구별하기 어려워도 아이별 일정을 알아볼 수 있어요.": {
      "comment": "Roadmap item detail: better colors and contrast",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozlišíte události jednotlivých dětí i se zapnutým Zvýšeným kontrastem nebo při potížích s rozlišením barev."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kend forskel på hvert barns begivenheder, også med Øg kontrast slået til, eller hvis farver er svære at skelne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkenne die Termine jedes Kindes auch bei aktiviertem „Kontrast erhöhen“ oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεχωρίστε τα συμβάντα κάθε παιδιού ακόμη και με ενεργή την Αύξηση αντίθεσης ή αν δυσκολεύεστε να ξεχωρίσετε χρώματα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell each child’s events apart, even with Increase Contrast on or if colors are hard to distinguish."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell each child’s events apart, even with Increase Contrast on or if colours are hard to distinguish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingue los eventos de cada niño aunque tengas activado Aumentar contraste o te cueste diferenciar los colores."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Erota jokaisen lapsen tapahtumat toisistaan, vaikka Lisää kontrastia olisi päällä tai värien erottaminen olisi vaikeaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Distinguez les événements de chaque enfant, même avec Contraste accru ou si les couleurs sont difficiles à différencier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedakan acara tiap anak, bahkan saat Tingkatkan Kontras aktif atau sulit membedakan warna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Distingui gli eventi di ogni bambino anche con Aumenta contrasto attivo o se fai fatica a distinguere i colori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントラストを上げたり、色の区別が難しい場合でも、お子さまごとの予定を見分けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대비를 높이거나 색을 구별하기 어려워도 아이별 일정을 알아볼 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se forskjell på hvert barns avtaler, selv med Øk kontrast på eller om det er vanskelig å skille farger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de afspraken van elk kind uit elkaar, ook met Verhoog contrast aan of als kleuren moeilijk te onderscheiden zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozróżniaj wydarzenia każdego dziecka, nawet przy włączonym zwiększonym kontraście lub gdy trudno odróżniać kolory."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diferencie os eventos de cada criança mesmo com Aumentar contraste ativado ou se tiver dificuldade com as cores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Различайте события каждого ребёнка даже с повышенной контрастностью или при трудностях с цветами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skilj på varje barns händelser, även med Öka kontrast på eller om det är svårt att skilja på färger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แยกกำหนดการของเด็กแต่ละคนออกได้ แม้เปิดเพิ่มคอนทราสต์หรือแยกสีได้ยาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrastı Artır açıkken ya da renkleri ayırt etmek zorsa bile her çocuğun etkinliklerini ayırt edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân biệt sự kiện của từng bé ngay cả khi bật Tăng độ tương phản hoặc khó phân biệt màu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使开启“增强对比度”或难以分辨颜色，也能分清每个孩子的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使開啟「提高對比」或不易分辨顏色，也能分清每個孩子的行程。"
          }
        }
      }
    },
