    },
    " · 캘린더에도 추가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " · Also added to Calendar"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " · 캘린더에도 추가"
          }
        }
      }
    },
    "%@님": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님"
          }
        }
      }
    },
    "%@님과 함께 보는 중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing with %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님과 함께 보는 중"
          }
        }
      }
    },
    "%@반": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@반"
          }
        }
      }
    },
    "%@의 반": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@’s Class"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 반"
          }
        }
      }
    },
    "%@의 일정 %lld개와 프로필 사진이 함께 삭제됩니다. 되돌릴 수 없어요.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@’s %2$lld event and profile photo will be deleted too. This can’t be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@’s %2$lld events and profile photo will be deleted too. This can’t be undone."
                }
              }
            }
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 일정 %lld개와 프로필 사진이 함께 삭제됩니다. 되돌릴 수 없어요."
          }
        }
      }
    },
    "%@의 일정과 연결됐어요. 이제 양쪽에서 함께 관리할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to %@’s events. You can now manage them together on both sides."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 일정과 연결됐어요. 이제 양쪽에서 함께 관리할 수 있어요."
          }
        }
      }
    },
    "%@의 프로필이 삭제됩니다. 되돌릴 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@’s profile will be deleted. This can’t be undone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 프로필이 삭제됩니다. 되돌릴 수 없어요."
          }
        }
      }
    },
    "'%@' 삭제": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 삭제"
          }
        }
      }
    },
    "1시간 뒤 일정이에요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts in 1 hour."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1시간 뒤 일정이에요."
          }
        }
      }
    },
    "1시간 전": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 hour before"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1시간 전"
          }
        }
      }
    },
    "1회성": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1회성"
          }
        }
      }
    },
    "Face ID 잠금": {
      "comment": "Roadmap item: Face ID lock",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID lock"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID 잠금"
          }
        }
      }
    },
    "Face ID나 Touch ID로 앱을 잠가 아이 일정을 지켜요.": {
      "comment": "Roadmap item detail: Face ID lock",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock the app with Face ID or Touch ID to keep your kids’ schedules private."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID나 Touch ID로 앱을 잠가 아이 일정을 지켜요."
          }
        }
      }
    },
    "Siri에게 물어 아이의 오늘 일정을 바로 확인해요.": {
      "comment": "Roadmap item detail: Siri and Shortcuts",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Siri what’s on your child’s schedule today."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri에게 물어 아이의 오늘 일정을 바로 확인해요."
          }
        }
      }
    },
    "Siri와 단축어": {
      "comment": "Roadmap item: Siri and Shortcuts",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri and Shortcuts"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri와 단축어"
          }
        }
      }
    },
    "VoiceOver가 달력과 일정을 빠짐없이, 알맞은 순서로 읽어 줘요.": {
      "comment": "Roadmap item detail: better VoiceOver support",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver reads the whole calendar and every event, in the right order."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver가 달력과 일정을 빠짐없이, 알맞은 순서로 읽어 줘요."
          }
        }
      }
    },
    "VoiceOver로 더 편하게": {
      "comment": "Roadmap item: better VoiceOver support",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Better VoiceOver support"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver로 더 편하게"
          }
        }
      }
    },
    "iCloud 상태를 확인하지 못했어요. 잠시 후 다시 시도해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check iCloud status. Please try again in a moment."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 상태를 확인하지 못했어요. 잠시 후 다시 시도해주세요."
          }
        }
      }
    },
    "iCloud 저장 공간이 부족해 일정을 올리지 못했어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough iCloud storage to upload your events."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 저장 공간이 부족해 일정을 올리지 못했어요."
          }
        }
      }
    },
    "iCloud에 로그인해야 가족 공유를 쓸 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to use Family Sharing."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인해야 가족 공유를 쓸 수 있어요."
          }
        }
      }
    },
    "iCloud에 로그인해야 가족 공유를 쓸 수 있어요. 설정 앱 > Apple 계정에서 로그인해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to use Family Sharing. Sign in under Settings > Apple Account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인해야 가족 공유를 쓸 수 있어요. 설정 앱 > Apple 계정에서 로그인해주세요."
          }
        }
      }
    },
    "iCloud에 로그인해야 가족과 일정을 공유할 수 있어요.\n설정 앱 > Apple 계정에서 로그인해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to share events with your family.\nSign in under Settings > Apple Account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인해야 가족과 일정을 공유할 수 있어요.\n설정 앱 > Apple 계정에서 로그인해주세요."
          }
        }
      }
    },
    "가져오기 완료": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import Complete"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 완료"
          }
        }
      }
    },
    "가족": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족"
          }
        }
      }
    },
    "가족 공유": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family Sharing"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족 공유"
          }
        }
      }
    },
    "가족 공유가 종료됐어요. 지금까지 받은 일정은 그대로 남아 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family sharing has ended. Events you’ve received so far stay as they are."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족 공유가 종료됐어요. 지금까지 받은 일정은 그대로 남아 있어요."
          }
        }
      }
    },
    "가족 공유를 중단했어요. 지금까지의 일정은 그대로 남아 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family sharing has stopped. Events so far stay as they are."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족 공유를 중단했어요. 지금까지의 일정은 그대로 남아 있어요."
          }
        }
      }
    },
    "가족 초대하기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite Family"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족 초대하기"
          }
        }
      }
    },
    "가족 초대해서 함께 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite Family to Share"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족 초대해서 함께 보기"
          }
        }
      }
    },
    "가족의 일정과 연결됨": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to a family’s events"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족의 일정과 연결됨"
          }
        }
      }
    },
    "공유 나가기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave Sharing"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 나가기"
          }
        }
      }
    },
    "공유 정보가 초기화됐어요. 다시 초대해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing info was reset. Please send an invitation again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 정보가 초기화됐어요. 다시 초대해주세요."
          }
        }
      }
    },
    "공유 중단": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Sharing"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 중단"
          }
        }
      }
    },
    "공유에서 나왔어요. 지금까지 받은 일정은 그대로 남아 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve left sharing. Events you’ve received so far stay as they are."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유에서 나왔어요. 지금까지 받은 일정은 그대로 남아 있어요."
          }
        }
      }
    },
    "공유할 일정이 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no events to share."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유할 일정이 없어요."
          }
        }
      }
    },
    "공통": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공통"
          }
        }
      }
    },
    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요.": {
      "comment": "Roadmap item detail: layouts for larger text",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        }
      }
    },
    "날짜를 선택하면 일정이 표시됩니다": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a date to see its events"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜를 선택하면 일정이 표시됩니다"
          }
        }
      }
    },
    "내 일정 한 번에 지우기": {
      "comment": "Roadmap item: delete all my data",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all my events"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 일정 한 번에 지우기"
          }
        }
      }
    },
    "내가 만든 가족 공유가 이미 있어요. ‘공유 중단’ 후에 초대를 수락해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have a family sharing of your own. Tap “Stop Sharing” first, then accept the invitation."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 만든 가족 공유가 이미 있어요. ‘공유 중단’ 후에 초대를 수락해주세요."
          }
        }
      }
    },
    "내일 일정이에요. 준비물을 미리 챙겨주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Happening tomorrow. Get things ready ahead of time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일 일정이에요. 준비물을 미리 챙겨주세요."
          }
        }
      }
    },
    "누구의 일정인가요?": {
