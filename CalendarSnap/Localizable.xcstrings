            "value": "An diesem Tag gibt es keine Termine"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν συμβάντα αυτή την ημέρα"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No events on this day"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "No events on this day"
          }
        },
        "es": {
