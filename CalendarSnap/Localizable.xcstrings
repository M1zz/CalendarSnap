    "iCloud에 로그인해야 가족 공유를 쓸 수 있어요. 설정 앱 > Apple 계정에서 로그인해주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro používání rodinného sdílení se přihlaste k iCloudu. Přihlásit se můžete v Nastavení > účet Apple."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på iCloud for at bruge familiedeling. Log ind under Indstillinger > Apple-konto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei iCloud an, um die Familienfreigabe zu nutzen. Anmelden unter Einstellungen > Apple-Account."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε στο iCloud για να χρησιμοποιήσετε την οικογενειακή κοινή χρήση. Συνδεθείτε από τις Ρυθμίσεις > λογαριασμός Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to use Family Sharing. Sign in under Settings > Apple Account."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to use Family Sharing. Sign in under Settings > Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en iCloud para usar Compartir en familia. Inicia sesión en Ajustes > cuenta de Apple."
          }
