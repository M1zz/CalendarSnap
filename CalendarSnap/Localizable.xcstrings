    "동그라미를 누르면 프로필 사진을 넣을 수 있어요. 반을 입력하면 통신문에서 다른 반 전용 일정(견학 등)을 자동으로 걸러줍니다. 새 학년에 반이 바뀌면 여기만 고쳐주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the circle to add a profile photo. If you enter a class, events meant only for other classes (such as outings) are filtered out of notices automatically. When the class changes in a new school year, just update it here."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the circle to add a profile photo. If you enter a class, events meant only for other classes (such as outings) are filtered out of notices automatically. When the class changes in a new school year, just update it here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丸いアイコンをタップするとプロフィール写真を設定できます。クラスを入力すると、お知らせに含まれる他のクラス専用の予定（見学など）が自動で除外されます。進級でクラスが変わったら、ここだけ直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동그라미를 누르면 프로필 사진을 넣을 수 있어요. 반을 입력하면 통신문에서 다른 반 전용 일정(견학 등)을 자동으로 걸러줍니다. 새 학년에 반이 바뀌면 여기만 고쳐주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按圆圈可设置头像。填写班级后，通知中仅属于其他班级的日程（如参观活动）会被自动过滤。新学年换班时，只需在这里修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點圓圈即可設定大頭照。填寫班級後，通知中僅屬於其他班級的行程（如參訪活動）會被自動過濾。新學年換班時，只需在這裡修改。"
          }
        }
      }
    },
    "동기화에 실패했어요. 잠시 후 다시 시도해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync failed. Please try again in a moment."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync failed. Please try again in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期に失敗しました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화에 실패했어요. 잠시 후 다시 시도해주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步失败，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步失敗，請稍後再試。"
          }
        }
      }
    },
    "마지막 동기화 %@ · 앱을 열 때와 일정을 바꿀 때 자동으로 맞춰져요.": {
      "localizations": {
        "en": {
