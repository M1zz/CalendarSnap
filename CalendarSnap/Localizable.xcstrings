    "이 가족의 일정을 더 이상 받지 않습니다. 지금까지 받은 일정은 그대로 남아요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Události této rodiny už nebudete dostávat. Dosud přijaté události zůstávají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du modtager ikke længere denne families begivenheder. Begivenheder, du allerede har modtaget, bliver liggende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erhältst keine Termine dieser Familie mehr. Bereits erhaltene Termine bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν θα λαμβάνετε πλέον τα συμβάντα αυτής της οικογένειας. Τα συμβάντα που έχετε ήδη λάβει παραμένουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll stop receiving this family’s events. Events you’ve received so far stay as they are."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll stop receiving this family’s events. Events you’ve received so far stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejarás de recibir los eventos de esta familia. Los eventos recibidos hasta ahora se conservan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Et enää saa tämän perheen tapahtumia. Jo vastaanotetut tapahtumat säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne recevrez plus les événements de cette famille. Les événements déjà reçus sont conservés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda tidak akan menerima acara keluarga ini lagi. Acara yang sudah diterima tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riceverai più gli eventi di questa famiglia. Gli eventi già ricevuti restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この家族の予定を受け取らなくなります。これまでに受け取った予定はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 가족의 일정을 더 이상 받지 않습니다. 지금까지 받은 일정은 그대로 남아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du mottar ikke lenger denne familiens avtaler. Avtaler du allerede har mottatt, blir værende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ontvangt de afspraken van dit gezin niet meer. Afspraken die je al hebt ontvangen, blijven bestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie będziesz już otrzymywać wydarzeń tej rodziny. Dotychczas otrzymane wydarzenia zostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não receberá mais os eventos desta família. Os eventos já recebidos continuam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы больше не будете получать события этой семьи. Полученные события останутся на месте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du får inte längre den här familjens händelser. Händelser du redan fått finns kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณจะไม่ได้รับกำหนดการของครอบครัวนี้อีก กำหนดการที่ได้รับมาแล้วจะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ailenin etkinliklerini artık almayacaksınız. Şimdiye kadar aldığınız etkinlikler olduğu gibi kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ không nhận sự kiện của gia đình này nữa. Các sự kiện đã nhận vẫn được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你将不再接收这个家庭的日程。目前收到的日程会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你將不再接收這個家庭的行程。目前收到的行程會保留。"
          }
        }
      }
    },
    "이 가족의 일정을 함께 보고 있어요. 내가 추가하거나 고친 일정도 상대에게 그대로 전달됩니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Události této rodiny sledujete společně. Události, které přidáte nebo upravíte, se jim také předají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I ser denne families begivenheder sammen. Begivenheder, du tilføjer eller ændrer, sendes også videre til dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst die Termine dieser Familie gemeinsam. Termine, die du hinzufügst oder änderst, werden ebenfalls weitergegeben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βλέπετε μαζί τα συμβάντα αυτής της οικογένειας. Τα συμβάντα που προσθέτετε ή αλλάζετε μεταφέρονται και σε αυτούς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re viewing this family’s events together. Events you add or edit are passed on to them as well."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re viewing this family’s events together. Events you add or edit are passed on to them as well."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás viendo los eventos de esta familia. Los eventos que añadas o edites también les llegarán a ellos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Katsotte tämän perheen tapahtumia yhdessä. Lisäämäsi tai muokkaamasi tapahtumat välittyvät myös heille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous consultez ensemble les événements de cette famille. Ceux que vous ajoutez ou modifiez leur sont aussi transmis."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda melihat acara keluarga ini bersama. Acara yang Anda tambah atau ubah juga diteruskan ke mereka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai vedendo insieme gli eventi di questa famiglia. Anche gli eventi che aggiungi o modifichi vengono inviati a loro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この家族と予定を一緒に見ています。あなたが追加・編集した予定も相手にそのまま届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 가족의 일정을 함께 보고 있어요. 내가 추가하거나 고친 일정도 상대에게 그대로 전달됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dere ser denne familiens avtaler sammen. Avtaler du legger til eller endrer, sendes også videre til dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bekijkt de afspraken van dit gezin samen. Afspraken die je toevoegt of wijzigt, worden ook naar hen doorgestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wspólnie oglądasz wydarzenia tej rodziny. Wydarzenia, które dodasz lub zmienisz, trafią też do nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está vendo os eventos desta família em conjunto. Os eventos que você adicionar ou editar também chegam a eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы вместе просматриваете события этой семьи. События, которые вы добавляете или меняете, тоже передаются им."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni tittar på den här familjens händelser tillsammans. Händelser du lägger till eller ändrar skickas också vidare till dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณกำลังดูกำหนดการของครอบครัวนี้ร่วมกัน กำหนดการที่คุณเพิ่มหรือแก้ไขก็จะส่งไปถึงอีกฝ่ายเช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ailenin etkinliklerini birlikte görüyorsunuz. Eklediğiniz ya da değiştirdiğiniz etkinlikler onlara da iletilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang cùng xem sự kiện của gia đình này. Sự kiện bạn thêm hoặc sửa cũng sẽ được gửi đến họ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在与这个家庭一起查看日程。你添加或修改的日程也会同步给对方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你正與這個家庭一起查看行程。你新增或修改的行程也會同步給對方。"
          }
        }
      }
    },
