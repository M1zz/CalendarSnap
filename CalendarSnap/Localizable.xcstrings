    "동그라미를 누르면 프로필 사진을 넣을 수 있어요. 반을 입력하면 통신문에서 다른 반 전용 일정(견학 등)을 자동으로 걸러줍니다. 새 학년에 반이 바뀌면 여기만 고쳐주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na kruh přidáte profilovou fotku. Když zadáte třídu, události určené jen pro jiné třídy (např. exkurze) se z oznámení automaticky odfiltrují. Když se třída v novém školním roce změní, stačí ji upravit tady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på cirklen for at tilføje et profilbillede. Hvis du angiver en stue, bliver begivenheder, der kun gælder for andre stuer (f.eks. udflugter), automatisk filtreret fra opslagene. Når stuen skifter i det nye år, skal du bare rette den her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf den Kreis, um ein Profilfoto hinzuzufügen. Wenn du eine Gruppe angibst, werden Termine, die nur für andere Gruppen gelten (z. B. Ausflüge), automatisch aus den Aushängen herausgefiltert. Wechselt die Gruppe im neuen Kita-Jahr, ändere sie einfach hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε τον κύκλο για να προσθέσετε φωτογραφία προφίλ. Αν εισαγάγετε τμήμα, τα συμβάντα που αφορούν μόνο άλλα τμήματα (π.χ. εκδρομές) φιλτράρονται αυτόματα από τις ανακοινώσεις. Όταν αλλάξει το τμήμα τη νέα σχολική χρονιά, διορθώστε το απλώς εδώ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the circle to add a profile photo. If you enter a class, events meant only for other classes (such as outings) are filtered out of notices automatically. When the class changes in a new school year, just update it here."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the circle to add a profile photo. If you enter a class, events meant only for other classes (such as outings) are filtered out of notices automatically. When the class changes in a new school year, just update it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el círculo para añadir una foto de perfil. Si indicas la clase, los eventos que son solo de otras clases (como salidas) se filtran solos de los avisos. Cuando cambie de clase en el nuevo curso, solo tienes que actualizarla aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta ympyrää lisätäksesi profiilikuvan. Jos syötät ryhmän, vain muille ryhmille tarkoitetut tapahtumat (esim. retket) suodatetaan tiedotteista pois automaattisesti. Kun ryhmä vaihtuu uutena toimintavuotena, muuta se vain täällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le cercle pour ajouter une photo de profil. Si vous indiquez une classe, les événements réservés à d’autres classes (comme les sorties) sont automatiquement écartés des affichages. Quand la classe change à la rentrée, modifiez-la simplement ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk lingkaran untuk menambahkan foto profil. Jika kelas diisi, acara yang khusus untuk kelas lain (seperti karyawisata) otomatis disaring dari pengumuman. Saat kelas berganti di tahun ajaran baru, cukup ubah di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il cerchio per aggiungere una foto profilo. Se inserisci la sezione, gli eventi riservati ad altre sezioni (come le gite) vengono esclusi in automatico dagli avvisi. Quando la sezione cambia nel nuovo anno, aggiornala qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丸いアイコンをタップするとプロフィール写真を設定できます。クラスを入力すると、お知らせに含まれる他のクラス専用の予定（見学など）が自動で除外されます。進級でクラスが変わったら、ここだけ直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동그라미를 누르면 프로필 사진을 넣을 수 있어요. 반을 입력하면 통신문에서 다른 반 전용 일정(견학 등)을 자동으로 걸러줍니다. 새 학년에 반이 바뀌면 여기만 고쳐주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på sirkelen for å legge til et profilbilde. Hvis du skriver inn en avdeling, filtreres avtaler som bare gjelder andre avdelinger (f.eks. turer) automatisk bort fra oppslagene. Når avdelingen endres i det nye barnehageåret, er det bare å rette den her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de cirkel om een profielfoto toe te voegen. Als je een groep invult, worden afspraken die alleen voor andere groepen gelden (zoals uitstapjes) automatisch uit de berichten gefilterd. Verandert de groep in het nieuwe schooljaar, pas het dan hier aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij kółko, aby dodać zdjęcie profilowe. Jeśli podasz grupę, wydarzenia przeznaczone tylko dla innych grup (np. wycieczki) zostaną automatycznie odfiltrowane z ogłoszeń. Gdy grupa zmieni się w nowym roku szkolnym, popraw ją tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no círculo para adicionar uma foto de perfil. Se você informar a turma, os eventos só de outras turmas (como passeios) são filtrados automaticamente dos avisos. Quando a turma mudar no ano seguinte, é só atualizar aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на кружок, чтобы добавить фото профиля. Если указать группу, события только для других групп (например, экскурсии) будут автоматически убираться из объявлений. Когда группа меняется в новом учебном году, просто поправьте её здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på cirkeln för att lägga till en profilbild. Om du anger en avdelning filtreras händelser som bara gäller andra avdelningar (t.ex. utflykter) bort automatiskt från anslagen. När avdelningen byts under nästa läsår behöver du bara ändra den här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะวงกลมเพื่อเพิ่มรูปโปรไฟล์ หากใส่ชั้นเรียน กำหนดการที่เฉพาะชั้นเรียนอื่น (เช่น ทัศนศึกษา) จะถูกกรองออกจากประกาศโดยอัตโนมัติ เมื่อขึ้นปีการศึกษาใหม่และเปลี่ยนชั้นเรียน แก้ไขที่นี่ได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil fotoğrafı eklemek için daireye dokunun. Sınıf girerseniz, yalnızca diğer sınıflara ait etkinlikler (gezi gibi) duyurulardan otomatik olarak ayıklanır. Yeni dönemde sınıf değişirse buradan düzeltmeniz yeterli."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào vòng tròn để thêm ảnh đại diện. Nếu nhập lớp, các sự kiện chỉ dành cho lớp khác (như tham quan) sẽ tự động được lọc khỏi thông báo. Khi sang năm học mới đổi lớp, bạn chỉ cần sửa ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按圆圈可设置头像。填写班级后，通知中仅属于其他班级的日程（如参观活动）会被自动过滤。新学年换班时，只需在这里修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕點圓圈即可設定大頭照。填寫班級後，通知中僅屬於其他班級的行程（如參訪活動）會被自動過濾。新學年換班時，只需在這裡修改。"
          }
        }
      }
    },
    "동기화에 실패했어요. 잠시 후 다시 시도해주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizace se nezdařila. Zkuste to za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniseringen mislykkedes. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist fehlgeschlagen. Versuche es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο συγχρονισμός απέτυχε. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync failed. Please try again in a moment."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync failed. Please try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error de sincronización. Inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkronointi epäonnistui. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la synchronisation. Réessayez dans un instant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi gagal. Coba lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzazione non riuscita. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期に失敗しました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화에 실패했어요. 잠시 후 다시 시도해주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniseringen mislyktes. Prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniseren mislukt. Probeer het zo meteen opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja nie powiodła się. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na sincronização. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось синхронизировать. Повторите попытку чуть позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Synkroniseringen misslyckades. Försök igen om en stund."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซิงค์ไม่สำเร็จ โปรดลองใหม่อีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşitleme başarısız oldu. Lütfen biraz sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ không thành công. Vui lòng thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步失败，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步失敗，請稍後再試。"
          }
        }
      }
    },
    "마지막 동기화 %@ · 앱을 열 때와 일정을 바꿀 때 자동으로 맞춰져요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslední synchronizace: %@ · Probíhá automaticky při otevření aplikace a při změně událostí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Senest synkroniseret: %@ · Synkroniserer automatisk, når du åbner appen eller ændrer begivenheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt synchronisiert: %@ · Wird beim Öffnen der App und bei Terminänderungen automatisch synchronisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τελευταίος συγχρονισμός: %@ · Γίνεται αυτόματα όταν ανοίγετε την εφαρμογή και όταν αλλάζουν συμβάντα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last synced %@ · Syncs automatically when you open the app or change events."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Last synced %@ · Syncs automatically when you open the app or change events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última sincronización: %@ · Se sincroniza automáticamente al abrir la app o cambiar eventos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viimeksi synkronoitu: %@ · Synkronoituu automaattisesti, kun avaat sovelluksen tai muutat tapahtumia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernière synchronisation : %@ · Synchronisation automatique à l’ouverture de l’app et à chaque modification."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terakhir disinkronkan: %@ · Disinkronkan otomatis saat aplikasi dibuka dan saat acara diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultima sincronizzazione: %@ · Si sincronizza da solo all’apertura dell’app e quando cambi gli eventi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終同期：%@ ・ アプリを開いたときと予定を変更したときに自動で同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 동기화 %@ · 앱을 열 때와 일정을 바꿀 때 자동으로 맞춰져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sist synkronisert: %@ · Synkroniserer automatisk når du åpner appen eller endrer avtaler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatst gesynchroniseerd: %@ · Wordt automatisch gesynchroniseerd bij het openen van de app en bij wijzigingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnia synchronizacja: %@ · Odbywa się automatycznie po otwarciu aplikacji i zmianie wydarzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Última sincronização: %@ · Sincroniza automaticamente ao abrir o app e ao alterar eventos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последняя синхронизация: %@ · Выполняется автоматически при открытии приложения и изменении событий."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Senast synkroniserad: %@ · Synkroniseras automatiskt när du öppnar appen eller ändrar händelser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซิงค์ล่าสุด: %@ · ซิงค์อัตโนมัติเมื่อเปิดแอปและเมื่อเปลี่ยนกำหนดการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son eşitleme: %@ · Uygulamayı açtığınızda ve etkinlikleri değiştirdiğinizde otomatik eşitlenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ lần cuối: %@ · Tự động đồng bộ khi mở ứng dụng và khi đổi sự kiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次同步：%@ · 打开 App 和修改日程时会自动同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次同步：%@ · 開啟 App 與修改行程時會自動同步。"
          }
        }
      }
    },
