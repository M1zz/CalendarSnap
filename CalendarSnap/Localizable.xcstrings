    "알아 두면 편한 기능을 알맞은 때에 살짝 알려 줘요.": {
      "comment": "Roadmap item detail: in-app tips",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle hints about useful features, right when you need them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle hints about useful features, right when you need them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pistas discretas sobre funciones útiles, justo cuando las necesitas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知っておくと便利な機能を、ちょうどよいタイミングでそっとお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알아 두면 편한 기능을 알맞은 때에 살짝 알려 줘요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ненавязчивые подсказки о полезных функциях — в нужный момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在合适的时候，轻轻提示实用功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在適當的時候，輕輕提示實用功能。"
          }
        }
      }
    },
