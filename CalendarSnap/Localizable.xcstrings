          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på iCloud for å bruke familiedeling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in bij iCloud om gezinsdeling te gebruiken."
          }
        },
