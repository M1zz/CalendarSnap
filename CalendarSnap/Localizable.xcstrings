    "Face ID나 Touch ID로 앱을 잠가 아이 일정을 지켜요.": {
      "comment": "Roadmap item detail: Face ID lock",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock the app with Face ID or Touch ID to keep your kids’ schedules private."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock the app with Face ID or Touch ID to keep your kids’ schedules private."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID나 Touch ID로 앱을 잠가 아이 일정을 지켜요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Face ID 或 Touch ID 锁定 App，保护孩子的日程隐私。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Face ID 或 Touch ID 鎖定 App，保護孩子行程的隱私。"
          }
        }
      }
    },
    "Siri에게 물어 아이의 오늘 일정을 바로 확인해요.": {
      "comment": "Roadmap item detail: Siri and Shortcuts",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Siri what’s on your child’s schedule today."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Siri what’s on your child’s schedule today."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri에게 물어 아이의 오늘 일정을 바로 확인해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问问 Siri，随时了解孩子今天的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問問 Siri，隨時掌握孩子今天的行程。"
          }
        }
      }
    },
