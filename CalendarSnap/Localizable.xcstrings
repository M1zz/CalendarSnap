            "value": "Aucun événement ce jour-là"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada acara pada hari ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun evento in questo giorno"
          }
        },
        "ja": {
