    "%@의 일정 %lld개와 프로필 사진이 함께 삭제됩니다. 되돌릴 수 없어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže se také profilová fotka a události dítěte %1$@ (%2$lld). Nelze vrátit zpět."
          }
        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@s %2$lld begivenhed og profilbillede slettes også. Det kan ikke fortrydes."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@s %2$lld begivenheder og profilbillede slettes også. Det kan ikke fortrydes."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Auch der Termin von %1$@ (%2$lld) und das Profilfoto werden gelöscht. Das lässt sich nicht rückgängig machen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Auch die %2$lld Termine von %1$@ und das Profilfoto werden gelöscht. Das lässt sich nicht rückgängig machen."
                }
              }
            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Θα διαγραφούν επίσης το %2$lld συμβάν του/της %1$@ και η φωτογραφία προφίλ. Δεν είναι δυνατή η αναίρεση."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Θα διαγραφούν επίσης τα %2$lld συμβάντα του/της %1$@ και η φωτογραφία προφίλ. Δεν είναι δυνατή η αναίρεση."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@’s %2$lld event and profile photo will be deleted too. This can’t be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@’s %2$lld events and profile photo will be deleted too. This can’t be undone."
                }
              }
            }
          }
        },
        "en-GB": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@’s %2$lld event and profile photo will be deleted too. This can’t be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@’s %2$lld events and profile photo will be deleted too. This can’t be undone."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "También se eliminarán el evento de %1$@ (%2$lld) y su foto de perfil. No se puede deshacer."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "También se eliminarán los %2$lld eventos de %1$@ y su foto de perfil. No se puede deshacer."
                }
              }
            }
          }
        },
        "fi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Myös lapsen %1$@ %2$lld tapahtuma ja profiilikuva poistetaan. Tätä ei voi perua."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Myös lapsen %1$@ %2$lld tapahtumaa ja profiilikuva poistetaan. Tätä ei voi perua."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "L’événement de %1$@ (%2$lld) et sa photo de profil seront aussi supprimés. Cette action est irréversible."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les %2$lld événements de %1$@ et sa photo de profil seront aussi supprimés. Cette action est irréversible."
                }
              }
            }
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld acara %1$@ dan foto profilnya juga akan dihapus. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "variations": {
            "plural": {
