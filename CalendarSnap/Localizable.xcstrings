    "알아 두면 편한 기능을 알맞은 때에 살짝 알려 줘요.": {
      "comment": "Roadmap item detail: in-app tips",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenápadné rady k užitečným funkcím přesně ve chvíli, kdy se hodí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskrete hints om nyttige funktioner, lige når du får brug for dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezente Hinweise auf nützliche Funktionen – genau dann, wenn du sie brauchst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διακριτικές υποδείξεις για χρήσιμες λειτουργίες, ακριβώς όταν τις χρειάζεστε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle hints about useful features, right when you need them."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle hints about useful features, right when you need them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pistas discretas sobre funciones útiles, justo cuando las necesitas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hienovaraisia vinkkejä hyödyllisistä toiminnoista juuri silloin, kun tarvitset niitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De discrètes astuces sur les fonctions utiles, au bon moment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Petunjuk halus tentang fitur berguna, tepat saat Anda butuhkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccoli suggerimenti sulle funzioni utili, proprio quando servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "知っておくと便利な機能を、ちょうどよいタイミングでそっとお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알아 두면 편한 기능을 알맞은 때에 살짝 알려 줘요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskrete tips om nyttige funksjoner akkurat når du trenger dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subtiele hints over handige functies, precies wanneer je ze nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyskretne podpowiedzi o przydatnych funkcjach, dokładnie wtedy, gdy ich potrzebujesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicas discretas sobre recursos úteis, na hora certa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ненавязчивые подсказки о полезных функциях — в нужный момент."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diskreta tips om användbara funktioner, precis när du behöver dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำแนะนำเบา ๆ เกี่ยวกับฟีเจอร์ที่มีประโยชน์ ในจังหวะที่ใช่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ihtiyaç duyduğunuz anda faydalı özelliklere dair ince ipuçları."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gợi ý nhẹ nhàng về các tính năng hữu ích, đúng lúc bạn cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在合适的时候，轻轻提示实用功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在適當的時候，輕輕提示實用功能。"
          }
        }
      }
    },
