    "업데이트 뒤 처음 열 때 무엇이 새로 생겼는지 알려 줘요.": {
      "comment": "Roadmap item detail: what's new after an update",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při prvním otevření po aktualizaci uvidíte, co je nového."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Første gang du åbner appen efter en opdatering, kan du se, hvad der er nyt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim ersten Öffnen nach einem Update siehst du, was neu ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Την πρώτη φορά που ανοίγετε την εφαρμογή μετά από μια ενημέρωση, δείτε τι νέο υπάρχει."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time you open the app after an update, see what’s new."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time you open the app after an update, see what’s new."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera vez que abras la app tras una actualización, verás las novedades."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun avaat sovelluksen ensimmäisen kerran päivityksen jälkeen, näet mikä on uutta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la première ouverture après une mise à jour, découvrez les nouveautés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat pertama membuka aplikasi setelah pembaruan, lihat apa yang baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima volta che apri l’app dopo un aggiornamento, scopri cosa c’è di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデート後に初めて開いたとき、新しくなった点をお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트 뒤 처음 열 때 무엇이 새로 생겼는지 알려 줘요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Første gang du åpner appen etter en oppdatering, ser du hva som er nytt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste keer dat je de app opent na een update, zie je wat er nieuw is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy pierwszym otwarciu aplikacji po aktualizacji zobaczysz, co nowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na primeira vez que abrir o app depois de uma atualização, veja o que há de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При первом запуске после обновления вы увидите, что нового."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
