    "내가 만든 가족 공유가 이미 있어요. ‘공유 중단’ 후에 초대를 수락해주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Už máte vlastní rodinné sdílení. Nejdřív klepněte na „Ukončit sdílení“ a pak přijměte pozvánku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har allerede en egen familiedeling. Tryk først på “Stop deling”, og accepter derefter invitationen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast bereits eine eigene Familienfreigabe. Tippe zuerst auf „Teilen beenden“ und nimm dann die Einladung an."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έχετε ήδη δική σας οικογενειακή κοινή χρήση. Πατήστε πρώτα «Διακοπή κοινής χρήσης» και μετά αποδεχτείτε την πρόσκληση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have a family sharing of your own. Tap “Stop Sharing” first, then accept the invitation."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "You already have a family sharing of your own. Tap “Stop Sharing” first, then accept the invitation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes un grupo familiar propio. Primero toca «Dejar de compartir» y luego acepta la invitación."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinulla on jo oma perhejako. Napauta ensin ”Lopeta jako” ja hyväksy sitten kutsu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà un partage familial à vous. Touchez d’abord « Arrêter le partage », puis acceptez l’invitation."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah punya berbagi keluarga sendiri. Ketuk “Hentikan Berbagi” dulu, lalu terima undangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già una condivisione familiare tua. Tocca prima «Interrompi condivisione», poi accetta l’invito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身で作成した家族共有がすでにあります。先に「共有を停止」してから招待を承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 만든 가족 공유가 이미 있어요. ‘공유 중단’ 후에 초대를 수락해주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har allerede en egen familiedeling. Trykk først på «Stopp deling», og godta deretter invitasjonen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt al een eigen gezinsdeling. Tik eerst op ‘Delen stoppen’ en accepteer daarna de uitnodiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz już własne udostępnianie rodzinne. Najpierw stuknij „Zakończ udostępnianie”, a potem zaakceptuj zaproszenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já tem um compartilhamento familiar próprio. Toque primeiro em “Parar de compartilhar” e depois aceite o convite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас уже есть собственный семейный доступ. Сначала нажмите «Закрыть общий доступ», затем примите приглашение."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har redan en egen familjedelning. Tryck först på ”Avsluta delning” och acceptera sedan inbjudan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณมีการแชร์ครอบครัวของตัวเองอยู่แล้ว แตะ “หยุดแชร์” ก่อน แล้วค่อยรับคำเชิญ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten kendi aile paylaşımınız var. Önce “Paylaşımı Durdur”a dokunun, ardından daveti kabul edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã có nhóm chia sẻ gia đình của riêng mình. Hãy chạm “Dừng chia sẻ” trước rồi mới chấp nhận lời mời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经创建了自己的家庭共享。请先点“停止共享”，再接受邀请。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已建立了自己的家庭共享。請先點「停止共享」，再接受邀請。"
          }
        }
      }
    },
    "내일 일정이에요. 준비물을 미리 챙겨주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je to zítra. Připravte si věci s předstihem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er i morgen. Gør tingene klar i god tid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Morgen ist es so weit. Bereite alles rechtzeitig vor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είναι αύριο. Ετοιμάστε τα πράγματα από νωρίς."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Happening tomorrow. Get things ready ahead of time."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Happening tomorrow. Get things ready ahead of time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es mañana. Ve preparando las cosas con tiempo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtuma on huomenna. Valmistele tavarat hyvissä ajoin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est demain. Préparez les affaires à l’avance."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara besok. Siapkan barang-barangnya dari sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È per domani. Prepara per tempo quello che serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日の予定です。持ち物を準備しておきましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일 일정이에요. 준비물을 미리 챙겨주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er i morgen. Gjør klart tingene i god tid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het is morgen. Leg de spullen op tijd klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To już jutro. Przygotuj rzeczy z wyprzedzeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É amanhã. Deixe tudo preparado com antecedência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Событие завтра. Подготовьте всё заранее."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är i morgon. Gör i ordning sakerna i god tid."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พรุ่งนี้มีกำหนดการ เตรียมของไว้ล่วงหน้านะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinlik yarın. Eşyaları önceden hazırlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày mai có sự kiện. Hãy chuẩn bị đồ trước nhé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天有日程，请提前准备好需带物品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明天有行程，請提前準備好需帶物品。"
          }
        }
      }
    },
