          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett datum för att se dess händelser"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกวันที่เพื่อดูกำหนดการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinliklerini görmek için bir tarih seçin"
          }
        },
        "vi": {
