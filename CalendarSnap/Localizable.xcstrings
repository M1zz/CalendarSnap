    "VoiceOver가 달력과 일정을 빠짐없이, 알맞은 순서로 읽어 줘요.": {
      "comment": "Roadmap item detail: better VoiceOver support",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver přečte celý kalendář i každou událost ve správném pořadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver læser hele kalenderen og alle begivenheder op i den rigtige rækkefølge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver liest den ganzen Kalender und jeden Termin in der richtigen Reihenfolge vor."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το VoiceOver διαβάζει ολόκληρο το ημερολόγιο και κάθε συμβάν, με τη σωστή σειρά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver reads the whole calendar and every event, in the right order."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver reads the whole calendar and every event, in the right order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver lee todo el calendario y cada evento, en el orden correcto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver lukee koko kalenterin ja jokaisen tapahtuman oikeassa järjestyksessä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver lit tout le calendrier et chaque événement, dans le bon ordre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver membacakan seluruh kalender dan setiap acara dengan urutan yang tepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver legge tutto il calendario e ogni evento, nell’ordine giusto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOverがカレンダーと予定を漏れなく、正しい順序で読み上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver가 달력과 일정을 빠짐없이, 알맞은 순서로 읽어 줘요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver leser opp hele kalenderen og hver avtale i riktig rekkefølge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver leest de hele agenda en elke afspraak voor, in de juiste volgorde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver czyta cały kalendarz i każde wydarzenie we właściwej kolejności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O VoiceOver lê o calendário inteiro e cada evento, na ordem certa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver читает весь календарь и каждое событие в правильном порядке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver läser upp hela kalendern och varje händelse i rätt ordning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver อ่านปฏิทินและกำหนดการทั้งหมดครบถ้วนตามลำดับที่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver tüm takvimi ve her etkinliği doğru sırayla okur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver đọc toàn bộ lịch và từng sự kiện theo đúng thứ tự."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver 会按正确的顺序读出完整的日历和每个日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver 會依正確順序朗讀完整的行事曆與每個行程。"
          }
        }
      }
    },
