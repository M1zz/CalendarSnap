            "state": "translated",
            "value": "Send Invitation · Manage People"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待リンクを送る・参加者を管理"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 링크 보내기 · 참여자 관리"
          }
        },
        "zh-Hans": {
          "stringUnit": {
