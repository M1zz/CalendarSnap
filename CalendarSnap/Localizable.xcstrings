    "이 날 일정 추가": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Event on This Day"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날 일정 추가"
          }
