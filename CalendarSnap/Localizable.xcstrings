    "어두운 화면에서도 달력과 일정이 또렷하게 보여요.": {
      "comment": "Roadmap item detail: dark mode",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calendar and events stay crisp and readable in Dark Mode."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The calendar and events stay crisp and readable in Dark Mode."
          }
