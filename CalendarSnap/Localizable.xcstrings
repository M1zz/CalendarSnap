                  "value": "Verranno eliminati anche i %2$lld eventi di %1$@ e la foto profilo. L’operazione non si può annullare."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さんの予定%2$lld件とプロフィール写真も一緒に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 일정 %lld개와 프로필 사진이 함께 삭제됩니다. 되돌릴 수 없어요."
          }
        },
        "nb": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@ sin %2$lld avtale og profilbildet slettes også. Dette kan ikke angres."
                }
