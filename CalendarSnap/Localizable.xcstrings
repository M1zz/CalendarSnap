    "초대 링크를 만들지 못했어요. 잠시 후 다시 시도해주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkaz s pozvánkou se nepodařilo vytvořit. Zkuste to za chvíli znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitationslinket kunne ikke oprettes. Prøv igen om lidt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einladungslink konnte nicht erstellt werden. Versuche es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η δημιουργία του συνδέσμου πρόσκλησης. Δοκιμάστε ξανά σε λίγο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t create the invitation link. Please try again in a moment."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t create the invitation link. Please try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear el enlace de invitación. Inténtalo de nuevo en un momento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutsulinkkiä ei voitu luoda. Yritä hetken kuluttua uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer le lien d’invitation. Réessayez dans un instant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan undangan tidak dapat dibuat. Coba lagi sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile creare il link d’invito. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待リンクを作成できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 링크를 만들지 못했어요. 잠시 후 다시 시도해주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke lage invitasjonslenken. Prøv igjen om litt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitnodigingslink kon niet worden gemaakt. Probeer het zo meteen opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć linku z zaproszeniem. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o link de convite. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать ссылку-приглашение. Повторите попытку чуть позже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbjudningslänken kunde inte skapas. Försök igen om en stund."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างลิงก์คำเชิญไม่สำเร็จ โปรดลองใหม่อีกครั้งในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet bağlantısı oluşturulamadı. Lütfen biraz sonra tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tạo liên kết mời. Vui lòng thử lại sau giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法生成邀请链接，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立邀請連結，請稍後再試。"
          }
        }
      }
    },
    "초대 링크를 보내면 배우자·조부모도 같은 일정을 보고 고칠 수 있어요. 한쪽에서 일정을 바꾸면 양쪽에 자동으로 반영됩니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošlete odkaz s pozvánkou a partner či prarodiče uvidí a budou moci upravovat stejné události. Změna na jedné straně se automaticky projeví na obou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send et invitationslink, så kan din partner eller bedsteforældre se og redigere de samme begivenheder. En ændring på den ene side opdateres automatisk på begge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende einen Einladungslink, dann können Partner oder Großeltern dieselben Termine sehen und bearbeiten. Eine Änderung auf einer Seite wird automatisch auf beiden aktualisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στείλτε έναν σύνδεσμο πρόσκλησης και ο/η σύντροφος ή οι παππούδες θα βλέπουν και θα επεξεργάζονται τα ίδια συμβάντα. Μια αλλαγή από τη μία πλευρά ενημερώνεται αυτόματα και στις δύο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send an invitation link and your partner or grandparents can see and edit the same events. A change on one side updates both automatically."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Send an invitation link and your partner or grandparents can see and edit the same events. A change on one side updates both automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un enlace de invitación y tu pareja o los abuelos podrán ver y editar los mismos eventos. Un cambio en un lado se actualiza automáticamente en ambos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä kutsulinkki, niin puolisosi tai isovanhempasi näkevät ja voivat muokata samoja tapahtumia. Toisella puolella tehty muutos päivittyy automaattisesti molemmille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez un lien d’invitation : votre conjoint ou les grands-parents peuvent voir et modifier les mêmes événements. Une modification d’un côté est mise à jour automatiquement des deux côtés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim tautan undangan, lalu pasangan atau kakek-nenek dapat melihat dan mengedit acara yang sama. Perubahan di satu sisi diperbarui otomatis di kedua sisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un link d’invito e il partner o i nonni potranno vedere e modificare gli stessi eventi. Una modifica da una parte si aggiorna automaticamente da entrambe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待リンクを送ると、配偶者や祖父母も同じ予定を見て編集できます。どちらかで変更すると、双方に自動で反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 링크를 보내면 배우자·조부모도 같은 일정을 보고 고칠 수 있어요. 한쪽에서 일정을 바꾸면 양쪽에 자동으로 반영됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send en invitasjonslenke, så kan partneren din eller besteforeldrene se og redigere de samme avtalene. En endring på den ene siden oppdateres automatisk på begge."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur een uitnodigingslink, dan kunnen je partner of opa’s en oma’s dezelfde afspraken zien en bewerken. Een wijziging aan de ene kant wordt automatisch aan beide kanten bijgewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij link z zaproszeniem, a partner lub dziadkowie zobaczą i będą mogli edytować te same wydarzenia. Zmiana po jednej stronie aktualizuje się automatycznie po obu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie um link de convite e seu cônjuge ou os avós poderão ver e editar os mesmos eventos. Uma alteração de um lado é atualizada automaticamente nos dois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте ссылку-приглашение, и партнёр или бабушки-дедушки смогут видеть и менять те же события. Изменения с одной стороны автоматически появятся у обоих."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka en inbjudningslänk, så kan din partner eller far- och morföräldrar se och redigera samma händelser. En ändring på ena sidan uppdateras automatiskt på båda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งลิงก์คำเชิญ แล้วคู่สมรสหรือปู่ย่าตายายจะเห็นและแก้ไขกำหนดการเดียวกันได้ การเปลี่ยนแปลงฝั่งหนึ่งจะอัปเดตทั้งสองฝั่งอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir davet bağlantısı gönderin; eşiniz ya da büyükanne-büyükbabalar aynı etkinlikleri görebilir ve düzenleyebilir. Bir taraftaki değişiklik iki tarafta da otomatik güncellenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi liên kết mời, vợ/chồng hoặc ông bà sẽ xem và sửa được cùng các sự kiện. Thay đổi ở một bên sẽ tự động cập nhật ở cả hai bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送邀请链接后，伴侣和祖父母也能查看并修改同样的日程。任何一方修改，双方都会自动更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳送邀請連結後，另一半與祖父母也能查看並修改相同的行程。任何一方修改，雙方都會自動更新。"
          }
        }
      }
    },
    "초대 링크를 보내지 못했어요.\n%@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkaz s pozvánkou se nepodařilo odeslat.\n%@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitationslinket kunne ikke sendes.\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Einladungslink konnte nicht gesendet werden.\n%@"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποστολή του συνδέσμου πρόσκλησης.\n%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t send the invitation link.\n%@"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t send the invitation link.\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo enviar el enlace de invitación.\n%@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutsulinkkiä ei voitu lähettää.\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’envoyer le lien d’invitation.\n%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tautan undangan tidak dapat dikirim.\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile inviare il link d’invito.\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待リンクを送信できませんでした。\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 링크를 보내지 못했어요.\n%@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke sende invitasjonslenken.\n%@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitnodigingslink kon niet worden verstuurd.\n%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wysłać linku z zaproszeniem.\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível enviar o link de convite.\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отправить ссылку-приглашение.\n%@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbjudningslänken kunde inte skickas.\n%@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งลิงก์คำเชิญไม่สำเร็จ\n%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet bağlantısı gönderilemedi.\n%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể gửi liên kết mời.\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发送邀请链接。\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法傳送邀請連結。\n%@"
          }
        }
      }
    },
    "초대 링크를 카카오톡·메시지로 보내면, 상대가 아이일정 앱에서 열어 바로 참여할 수 있어요. 이후에는 어느 쪽에서 일정을 추가하거나 고쳐도 양쪽에 자동으로 반영됩니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošlete odkaz s pozvánkou ve zprávě a druhá strana se po otevření v aplikaci hned připojí. Události přidané nebo upravené na jedné straně se pak automaticky aktualizují na obou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Send et invitationslink i en besked, så kan de åbne det i appen og være med med det samme. Derefter opdateres begivenheder, der tilføjes eller ændres på den ene side, automatisk på begge sider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende einen Einladungslink per Nachricht, dann können sie ihn in der App öffnen und sofort mitmachen. Danach werden Termine, die auf einer Seite hinzugefügt oder geändert werden, automatisch auf beiden aktualisiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στείλτε έναν σύνδεσμο πρόσκλησης με μήνυμα και θα τον ανοίξουν στην εφαρμογή και θα συμμετάσχουν αμέσως. Έπειτα, τα συμβάντα που προστίθενται ή αλλάζουν από τη μία πλευρά ενημερώνονται αυτόματα και στις δύο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send an invitation link by message and they can open it in the app and join right away. After that, events added or edited on either side update on both automatically."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Send an invitation link by message and they can open it in the app and join right away. After that, events added or edited on either side update on both automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un enlace de invitación por mensaje y podrán abrirlo en la app y unirse al instante. Después, los eventos que se añadan o editen en cualquiera de los dos lados se actualizan automáticamente en ambos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetä kutsulinkki viestillä, niin toinen avaa sen sovelluksessa ja liittyy heti mukaan. Sen jälkeen toisella puolella lisätyt tai muutetut tapahtumat päivittyvät automaattisesti molemmille."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez un lien d’invitation par message : la personne l’ouvre dans l’app et rejoint aussitôt. Ensuite, les événements ajoutés ou modifiés d’un côté sont mis à jour automatiquement des deux côtés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim tautan undangan lewat pesan, lalu mereka dapat membukanya di aplikasi dan langsung bergabung. Setelah itu, acara yang ditambah atau diubah di salah satu sisi diperbarui otomatis di kedua sisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia un link d’invito con un messaggio: l’altra persona lo apre nell’app e si unisce subito. Da allora, gli eventi aggiunti o modificati da una parte si aggiornano automaticamente anche dall’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待リンクをメッセージで送ると、相手がアプリで開いてすぐに参加できます。その後は、どちらで予定を追加・編集しても双方に自動で反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 링크를 카카오톡·메시지로 보내면, 상대가 아이일정 앱에서 열어 바로 참여할 수 있어요. 이후에는 어느 쪽에서 일정을 추가하거나 고쳐도 양쪽에 자동으로 반영됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Send en invitasjonslenke i en melding, så kan de åpne den i appen og bli med med en gang. Etter det oppdateres avtaler som legges til eller endres på den ene siden, automatisk på begge sider."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur een uitnodigingslink in een bericht, dan openen ze die in de app en doen ze meteen mee. Daarna worden afspraken die aan één kant worden toegevoegd of gewijzigd automatisch aan beide kanten bijgewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij link z zaproszeniem w wiadomości, a druga osoba otworzy go w aplikacji i od razu dołączy. Potem wydarzenia dodane lub zmienione po jednej stronie aktualizują się automatycznie po obu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie um link de convite por mensagem e a pessoa abre no app e entra na hora. Depois disso, os eventos adicionados ou editados de um lado são atualizados automaticamente nos dois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте ссылку-приглашение в сообщении, и человек сможет сразу присоединиться в приложении. После этого события, добавленные или изменённые с любой стороны, автоматически обновляются у обоих."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka en inbjudningslänk i ett meddelande, så öppnar de den i appen och går med direkt. Därefter uppdateras händelser som läggs till eller ändras på ena sidan automatiskt på båda."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งลิงก์คำเชิญทางข้อความ อีกฝ่ายเปิดในแอปแล้วเข้าร่วมได้ทันที หลังจากนั้นกำหนดการที่เพิ่มหรือแก้ไขฝั่งใดฝั่งหนึ่งจะอัปเดตทั้งสองฝั่งอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajla bir davet bağlantısı gönderin; karşı taraf uygulamada açıp hemen katılabilir. Sonrasında bir tarafta eklenen ya da değiştirilen etkinlikler iki tarafta da otomatik güncellenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi liên kết mời qua tin nhắn, người nhận mở trong ứng dụng là tham gia ngay. Sau đó, sự kiện thêm hoặc sửa ở bên nào cũng tự động cập nhật ở cả hai bên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过消息发送邀请链接，对方在 App 中打开即可加入。之后无论哪一方添加或修改日程，双方都会自动更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過訊息傳送邀請連結，對方在 App 中開啟即可加入。之後無論哪一方新增或修改行程，雙方都會自動更新。"
          }
        }
      }
    },
    "초대받은 사람도 일정을 추가·수정할 수 있어요. 아이 프로필 사진은 공유되지 않습니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozvaní mohou události také přidávat a upravovat. Profilové fotky dětí se nesdílejí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviterede kan også tilføje og redigere begivenheder. Børnenes profilbilleder deles ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingeladene können ebenfalls Termine hinzufügen und bearbeiten. Profilfotos der Kinder werden nicht geteilt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όσοι προσκληθούν μπορούν επίσης να προσθέτουν και να επεξεργάζονται συμβάντα. Οι φωτογραφίες προφίλ των παιδιών δεν κοινοποιούνται."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "People you invite can add and edit events too. Children’s profile photos aren’t shared."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "People you invite can add and edit events too. Children’s profile photos aren’t shared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las personas invitadas también pueden añadir y editar eventos. Las fotos de perfil de los niños no se comparten."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutsutut voivat myös lisätä ja muokata tapahtumia. Lasten profiilikuvia ei jaeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes invitées peuvent aussi ajouter et modifier des événements. Les photos de profil des enfants ne sont pas partagées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Orang yang diundang juga dapat menambah dan mengubah acara. Foto profil anak tidak dibagikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le persone invitate possono aggiungere e modificare eventi. Le foto profilo dei bambini non vengono condivise."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待された人も予定を追加・編集できます。お子さまのプロフィール写真は共有されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대받은 사람도 일정을 추가·수정할 수 있어요. 아이 프로필 사진은 공유되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviterte kan også legge til og redigere avtaler. Barnas profilbilder deles ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgenodigden kunnen ook afspraken toevoegen en wijzigen. Profielfoto’s van kinderen worden niet gedeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaproszone osoby też mogą dodawać i edytować wydarzenia. Zdjęcia profilowe dzieci nie są udostępniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem for convidado também pode adicionar e editar eventos. As fotos de perfil das crianças não são compartilhadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглашённые тоже могут добавлять и менять события. Фото профиля детей не передаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbjudna kan också lägga till och redigera händelser. Barnens profilbilder delas inte."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้ที่ได้รับเชิญเพิ่มและแก้ไขกำหนดการได้เช่นกัน รูปโปรไฟล์ของเด็กจะไม่ถูกแชร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet edilenler de etkinlik ekleyip düzenleyebilir. Çocukların profil fotoğrafları paylaşılmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người được mời cũng có thể thêm và sửa sự kiện. Ảnh đại diện của bé không được chia sẻ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被邀请的人也可以添加和修改日程。孩子的头像不会被共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受邀的人也可以新增與修改行程。孩子的大頭照不會被共享。"
          }
        }
      }
    },
    "초대한 가족": {
