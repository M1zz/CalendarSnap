    "처음 열었을 때 사진으로 일정을 넣는 법을 짧게 보여 줘요.": {
      "comment": "Roadmap item detail: first-run guide",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short guide to adding events from a photo, the first time you open the app."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A short guide to adding events from a photo, the first time you open the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una guía corta para añadir eventos desde una foto la primera vez que abres la app."
          }
