          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på iCloud for at bruge familiedeling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich bei iCloud an, um die Familienfreigabe zu nutzen."
