            "value": "Joined"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참여 중"
          }
        }
      }
    },
    "참여자를 빼거나 권한을 바꾸려면 아래 ‘참여자 관리’를 눌러주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
