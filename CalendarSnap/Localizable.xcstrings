    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요.": {
      "comment": "Roadmap item detail: layouts for larger text",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při zvětšení písma se obrazovky přehledně uspořádají, místo aby se oříznuly."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skærmene omarrangeres pænt i stedet for at blive skåret af, når du gør teksten større."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei größerer Schrift ordnen sich die Bildschirme sauber neu an, statt abgeschnitten zu werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι οθόνες αναδιατάσσονται όμορφα αντί να κόβονται όταν μεγεθύνετε το κείμενο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las pantallas se reorganizan bien en lugar de cortarse al aumentar el texto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytöt järjestyvät siististi uudelleen sen sijaan, että ne leikkautuisivat, kun suurennat tekstiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les écrans se réorganisent proprement au lieu d’être coupés quand vous agrandissez le texte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan tersusun ulang dengan rapi, tidak terpotong, saat teks diperbesar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le schermate si riorganizzano bene invece di tagliarsi quando ingrandisci il testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字サイズを大きくしても、切れずに見やすくレイアウトが整います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skjermene ordner seg pent i stedet for å bli kuttet når du gjør teksten større."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermen ordenen zich netjes opnieuw in plaats van afgesneden te worden als je de tekst vergroot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po powiększeniu tekstu ekrany układają się czytelnie, zamiast być ucinane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As telas se reorganizam direitinho, sem cortar, quando você aumenta o texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При увеличении текста экраны аккуратно перестраиваются, а не обрезаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skärmarna ordnar om sig snyggt i stället för att klippas av när du förstorar texten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อขยายตัวอักษร หน้าจอจะจัดเรียงใหม่อย่างเรียบร้อยโดยไม่ถูกตัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni büyüttüğünüzde ekranlar kesilmek yerine düzgünce yeniden yerleşir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình tự sắp xếp gọn gàng thay vì bị cắt khi bạn phóng to chữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大文字时，界面会重新排版，不再被截断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大文字時，畫面會重新排版，不再被截斷。"
          }
        }
      }
    },
    "날짜를 선택하면 일정이 표시됩니다": {
      "localizations": {
