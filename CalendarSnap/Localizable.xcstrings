    "참여자를 빼거나 권한을 바꾸려면 아래 ‘참여자 관리’를 눌러주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li někoho odebrat nebo změnit oprávnění, klepněte níže na „Správa lidí“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på “Administrer personer” nedenfor for at fjerne nogen eller ændre rettigheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Entfernen von Personen oder Ändern von Rechten tippe unten auf „Personen verwalten“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να αφαιρέσετε κάποιον ή να αλλάξετε δικαιώματα, πατήστε «Διαχείριση ατόμων» παρακάτω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To remove someone or change permissions, tap “Manage People” below."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "To remove someone or change permissions, tap “Manage People” below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para quitar a alguien o cambiar permisos, toca «Gestionar personas» más abajo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista joku tai muuta oikeuksia napauttamalla alla ”Hallitse henkilöitä”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour retirer quelqu’un ou modifier les droits, touchez « Gérer les personnes » ci-dessous."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk mengeluarkan seseorang atau mengubah izin, ketuk “Kelola Orang” di bawah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per rimuovere qualcuno o cambiare i permessi, tocca «Gestisci persone» qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加者の削除や権限の変更は、下の「参加者を管理」から行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참여자를 빼거나 권한을 바꾸려면 아래 ‘참여자 관리’를 눌러주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å fjerne noen eller endre tillatelser trykker du på «Administrer personer» nedenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om iemand te verwijderen of rechten te wijzigen, tik je hieronder op ‘Personen beheren’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby kogoś usunąć lub zmienić uprawnienia, stuknij poniżej „Zarządzaj osobami”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para remover alguém ou mudar permissões, toque em “Gerenciar pessoas” abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы удалить участника или изменить права, нажмите «Участники» ниже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du vill ta bort någon eller ändra behörigheter trycker du på ”Hantera personer” nedan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากต้องการนำใครออกหรือเปลี่ยนสิทธิ์ ให้แตะ “จัดการผู้ร่วมแชร์” ด้านล่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birini çıkarmak ya da izinleri değiştirmek için aşağıdaki “Kişileri Yönet”e dokunun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để xóa ai đó hoặc đổi quyền, hãy chạm “Quản lý người tham gia” bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需移除成员或更改权限，请点按下方的“管理成员”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若要移除成員或更改權限，請輕點下方的「管理成員」。"
          }
        }
      }
    },
