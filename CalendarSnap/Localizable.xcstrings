          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "De %2$lld afspraak van %1$@ en de profielfoto worden ook verwijderd. Dit kan niet ongedaan worden gemaakt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "De %2$lld afspraken van %1$@ en de profielfoto worden ook verwijderd. Dit kan niet ongedaan worden gemaakt."
                }
              }
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie usunięte także zdjęcie profilowe i wydarzenia dziecka %1$@ (%2$lld). Nie można tego cofnąć."
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "O evento de %1$@ (%2$lld) e a foto de perfil também serão excluídos. Não é possível desfazer."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Os %2$lld eventos de %1$@ e a foto de perfil também serão excluídos. Não é possível desfazer."
                }
              }
            }
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе с профилем будут удалены фото и события (%2$lld) ребёнка: %1$@. Это нельзя отменить."
          }
        },
        "sv": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@s %2$lld händelse och profilbild tas också bort. Det går inte att ångra."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@s %2$lld händelser och profilbild tas också bort. Det går inte att ångra."
                }
              }
            }
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดการ %2$lld รายการของ %1$@ และรูปโปรไฟล์จะถูกลบไปด้วย ไม่สามารถย้อนกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ çocuğunun %2$lld etkinliği ve profil fotoğrafı da silinecek. Bu işlem geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld sự kiện của %1$@ và ảnh đại diện cũng sẽ bị xóa. Không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的 %2$lld 个日程和头像将一并删除，且无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的 %2$lld 個行程與大頭照將一併刪除，且無法復原。"
          }
        }
      }
    },
    "%@의 일정과 연결됐어요. 이제 양쪽에서 함께 관리할 수 있어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Propojeno s událostmi uživatele %@. Teď je můžete spravovat společně z obou stran."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbundet til %@s begivenheder. Nu kan I styre dem sammen fra begge sider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit den Terminen von %@ verbunden. Ihr könnt sie jetzt gemeinsam verwalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδέθηκε με τα συμβάντα του/της %@. Τώρα μπορείτε να τα διαχειρίζεστε μαζί και από τις δύο πλευρές."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to %@’s events. You can now manage them together on both sides."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to %@’s events. You can now manage them together on both sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado con los eventos de %@. Ahora podéis gestionarlos juntos desde los dos lados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhdistetty käyttäjän %@ tapahtumiin. Nyt voitte hallita niitä yhdessä molemmin puolin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté aux événements de %@. Vous pouvez désormais les gérer ensemble des deux côtés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terhubung ke acara %@. Sekarang kalian dapat mengelolanya bersama dari kedua sisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegato agli eventi di %@. Ora potete gestirli insieme da entrambe le parti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の予定とつながりました。これからは双方で一緒に管理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 일정과 연결됐어요. 이제 양쪽에서 함께 관리할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koblet til %@ sine avtaler. Nå kan dere administrere dem sammen fra begge sider."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbonden met de afspraken van %@. Jullie kunnen ze nu samen beheren vanaf beide kanten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączono z wydarzeniami użytkownika %@. Teraz możecie zarządzać nimi razem po obu stronach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado aos eventos de %@. Agora vocês podem gerenciá-los juntos dos dois lados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено к событиям: %@. Теперь вы можете вести их вместе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ansluten till %@s händelser. Nu kan ni hantera dem tillsammans från båda håll."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อกับกำหนดการของ %@ แล้ว ตอนนี้ทั้งสองฝั่งช่วยกันจัดการได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişisinin etkinlikleriyle bağlantı kuruldu. Artık iki taraftan birlikte yönetebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã kết nối với sự kiện của %@. Giờ hai bên có thể cùng quản lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已与 %@ 的日程关联。现在双方可以一起管理了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已與 %@ 的行程連結。現在雙方可以一起管理了。"
          }
        }
      }
    },
