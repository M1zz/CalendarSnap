    "여기에 어린이집 문자·카카오톡 메시지를 붙여넣으세요.\n예) 내일은 비가 예정된 만큼 장화, 우의, 우산에 이름을 적어 보내주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte sem zprávu ze školky.\nNapř. Zítra má pršet, podepište prosím holínky, pláštěnku a deštník."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt en besked fra børnehaven her.\nF.eks. I morgen bliver det regnvejr, så skriv navn på gummistøvler, regntøj og paraply."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge hier eine Nachricht von der Kita ein.\nz. B. Morgen ist Regen angesagt, bitte Gummistiefel, Regenjacke und Schirm mit Namen versehen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επικολλήστε εδώ ένα μήνυμα από τον παιδικό σταθμό.\nΠ.χ. Αύριο αναμένεται βροχή, γράψτε το όνομα στις γαλότσες, το αδιάβροχο και την ομπρέλα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a message from your daycare here.\ne.g. Rain is expected tomorrow, so please label your child’s boots, raincoat and umbrella."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a message from your nursery here.\ne.g. Rain is expected tomorrow, so please label your child’s boots, raincoat and umbrella."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega aquí un mensaje de la guardería.\nP. ej., mañana se espera lluvia, así que marca con el nombre las botas, el chubasquero y el paraguas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä tähän viesti päiväkodista.\nEsim. Huomenna on luvassa sadetta, kirjoittakaa nimi kumisaappaisiin, sadetakkiin ja sateenvarjoon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez ici un message de la crèche.\nEx. : de la pluie est prévue demain, merci de marquer le nom sur les bottes, l’imperméable et le parapluie."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel pesan dari sekolah di sini.\nMis. Besok diperkirakan hujan, mohon tuliskan nama pada sepatu bot, jas hujan, dan payung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla qui un messaggio del nido.\nEs. Domani è prevista pioggia: scrivete il nome su stivali, impermeabile e ombrello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに保育園からのメッセージを貼り付けてください。\n例）明日は雨の予報です。長靴・レインコート・傘に名前を書いてお持ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 어린이집 문자·카카오톡 메시지를 붙여넣으세요.\n예) 내일은 비가 예정된 만큼 장화, 우의, 우산에 이름을 적어 보내주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn en melding fra barnehagen her.\nF.eks. I morgen er det meldt regn, så skriv navn på gummistøvler, regntøy og paraply."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak hier een bericht van de opvang.\nBijv. Morgen wordt regen verwacht, schrijf daarom de naam op laarzen, regenjas en paraplu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej tutaj wiadomość z przedszkola.\nNp. Jutro zapowiadany jest deszcz, prosimy podpisać kalosze, płaszcz przeciwdeszczowy i parasol."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole aqui uma mensagem da escolinha.\nEx.: Amanhã está prevista chuva, então escrevam o nome nas botas, na capa de chuva e no guarda-chuva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте сюда сообщение из детского сада.\nНапример: завтра ожидается дождь, подпишите, пожалуйста, сапоги, дождевик и зонт."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in ett meddelande från förskolan här.\nT.ex. I morgon väntas regn, så skriv namn på gummistövlar, regnkläder och paraply."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางข้อความจากโรงเรียนที่นี่\nเช่น พรุ่งนี้ฝนอาจตก โปรดเขียนชื่อบนรองเท้าบู๊ต เสื้อกันฝน และร่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreşten gelen mesajı buraya yapıştırın.\nÖrn. Yarın yağmur bekleniyor, lütfen çizme, yağmurluk ve şemsiyenin üzerine isim yazın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán tin nhắn của trường vào đây.\nVí dụ: Ngày mai trời có mưa, phụ huynh vui lòng ghi tên lên ủng, áo mưa và ô của bé."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此粘贴幼儿园发来的消息。\n例如：明天有雨，请给孩子的雨靴、雨衣和雨伞写上名字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此貼上幼兒園傳來的訊息。\n例如：明天預計下雨，請在孩子的雨鞋、雨衣和雨傘上寫好名字。"
          }
        }
      }
    },
