    "iCloud 상태를 확인하지 못했어요. 잠시 후 다시 시도해주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check iCloud status. Please try again in a moment."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t check iCloud status. Please try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comprobar el estado de iCloud. Inténtalo de nuevo en un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudの状態を確認できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
