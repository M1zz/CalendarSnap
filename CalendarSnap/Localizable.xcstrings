            "value": "Cả ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整天"
          }
        }
      }
    },
    "종일 일정(소풍·현장학습 등)은 ‘전날 저녁’과 ‘당일 아침’ 알림만 울립니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "U celodenních událostí (např. výletů) přijdou jen připomínky „večer předem“ a „ráno téhož dne“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Heldagsbegivenheder (f.eks. udflugter) får kun påmindelserne “aftenen før” og “om morgenen samme dag”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für ganztägige Termine (z. B. Ausflüge) gibt es nur die Erinnerungen „am Vorabend“ und „am Morgen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα ολοήμερα συμβάντα (π.χ. εκδρομές) λαμβάνουν μόνο τις υπενθυμίσεις «το προηγούμενο βράδυ» και «το πρωί της ημέρας»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All-day events (such as field trips) only get the “evening before” and “morning of” reminders."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "All-day events (such as school trips) only get the “evening before” and “morning of” reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eventos de todo el día (como excursiones) solo reciben los recordatorios «la tarde anterior» y «por la mañana»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koko päivän tapahtumille (esim. retket) tulee vain muistutukset ”edellisenä iltana” ja ”aamulla”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les événements sur toute la journée (comme les sorties) ne reçoivent que les rappels « la veille au soir » et « le matin même »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Acara seharian (seperti karyawisata) hanya mendapat pengingat “malam sebelumnya” dan “pagi harinya”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli eventi di tutto il giorno (come le gite) ricevono solo i promemoria «la sera prima» e «la mattina stessa»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終日の予定（遠足・校外学習など）には、「前日の夜」と「当日の朝」の通知だけが届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종일 일정(소풍·현장학습 등)은 ‘전날 저녁’과 ‘당일 아침’ 알림만 울립니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Heldagsavtaler (f.eks. turer) får bare påminnelsene «kvelden før» og «samme morgen»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor afspraken van een hele dag (zoals uitstapjes) komen alleen de herinneringen ‘de avond ervoor’ en ‘die ochtend’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wydarzenia całodniowe (np. wycieczki) dostają tylko przypomnienia „wieczorem dzień wcześniej” i „rano tego dnia”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos de dia inteiro (como passeios) só recebem os lembretes “na noite anterior” e “na manhã do dia”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для событий на весь день (например, экскурсий) приходят только напоминания «накануне вечером» и «утром в тот же день»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Heldagshändelser (t.ex. utflykter) får bara påminnelserna ”kvällen före” och ”på morgonen samma dag”."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กำหนดการทั้งวัน (เช่น ทัศนศึกษา) จะมีแค่การแจ้งเตือน “เย็นวันก่อน” และ “เช้าวันนั้น”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm gün süren etkinlikler (gezi gibi) yalnızca “bir gün önce akşam” ve “o gün sabah” hatırlatıcılarını alır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự kiện cả ngày (như dã ngoại) chỉ có lời nhắc “tối hôm trước” và “sáng hôm đó”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全天日程（如春游、校外活动）只会在“前一天晚上”和“当天早上”提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整天行程（如校外教學）只會在「前一天晚上」與「當天早上」提醒。"
          }
        }
      }
    },
