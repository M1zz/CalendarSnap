    "%@의 일정 %lld개와 프로필 사진이 함께 삭제됩니다. 되돌릴 수 없어요.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@’s %2$lld event and profile photo will be deleted too. This can’t be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@’s %2$lld events and profile photo will be deleted too. This can’t be undone."
                }
              }
            }
          }
        },
        "en-GB": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@’s %2$lld event and profile photo will be deleted too. This can’t be undone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%1$@’s %2$lld events and profile photo will be deleted too. This can’t be undone."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "También se eliminarán el evento de %1$@ (%2$lld) y su foto de perfil. No se puede deshacer."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "También se eliminarán los %2$lld eventos de %1$@ y su foto de perfil. No se puede deshacer."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さんの予定%2$lld件とプロフィール写真も一緒に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 일정 %lld개와 프로필 사진이 함께 삭제됩니다. 되돌릴 수 없어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе с профилем будут удалены фото и события (%2$lld) ребёнка: %1$@. Это нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的 %2$lld 个日程和头像将一并删除，且无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的 %2$lld 個行程與大頭照將一併刪除，且無法復原。"
          }
        }
      }
    },
    "%@의 일정과 연결됐어요. 이제 양쪽에서 함께 관리할 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to %@’s events. You can now manage them together on both sides."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to %@’s events. You can now manage them together on both sides."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado con los eventos de %@. Ahora podéis gestionarlos juntos desde los dos lados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の予定とつながりました。これからは双方で一緒に管理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 일정과 연결됐어요. 이제 양쪽에서 함께 관리할 수 있어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено к событиям: %@. Теперь вы можете вести их вместе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已与 %@ 的日程关联。现在双方可以一起管理了。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已與 %@ 的行程連結。現在雙方可以一起管理了。"
          }
        }
      }
    },
    "%@의 프로필이 삭제됩니다. 되돌릴 수 없어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@’s profile will be deleted. This can’t be undone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "%@’s profile will be deleted. This can’t be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará el perfil de %@. No se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんのプロフィールが削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 프로필이 삭제됩니다. 되돌릴 수 없어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль ребёнка «%@» будет удалён. Это нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的资料将被删除，且无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的資料將被刪除，且無法復原。"
          }
        }
      }
    },
