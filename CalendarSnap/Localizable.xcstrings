        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增或儲存行程時，輕輕震動一下提醒你。"
          }
        }
      }
    },
    "일정을 적다가 앱이 꺼져도 쓰던 내용이 남아 있어요.": {
      "comment": "Roadmap item detail: keep unsaved drafts",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co jste psali, zůstane, i když se aplikace uprostřed zavře."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, du var i gang med at skrive, bliver stående, selv hvis appen lukker undervejs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du gerade eingibst, bleibt erhalten – auch wenn die App zwischendurch schließt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ό,τι πληκτρολογούσατε μένει στη θέση του, ακόμη κι αν η εφαρμογή κλείσει στη μέση."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you were typing stays put, even if the app closes mid-way."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "What you were typing stays put, even if the app closes mid-way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que estabas escribiendo se conserva aunque la app se cierre a medias."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjoittamasi pysyy tallessa, vaikka sovellus sulkeutuisi kesken kaiken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous saisissiez reste en place, même si l’app se ferme en cours de route."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yang sedang Anda ketik tetap ada, meski aplikasi tertutup di tengah jalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che stavi scrivendo resta lì, anche se l’app si chiude a metà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を入力中にアプリが終了しても、入力した内容が残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정을 적다가 앱이 꺼져도 쓰던 내용이 남아 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du skrev, blir stående, selv om appen lukkes underveis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je aan het typen was, blijft staan, ook als de app halverwege sluit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co wpisujesz, zostaje na miejscu, nawet jeśli aplikacja zamknie się w trakcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você estava digitando continua lá, mesmo que o app feche no meio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набранный текст не пропадёт, даже если приложение закроется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det du skrev finns kvar, även om appen stängs halvvägs."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่พิมพ์ค้างไว้ยังอยู่ แม้แอปจะปิดไปกลางคัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdıklarınız, uygulama yarıda kapansa bile yerinde kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung đang nhập vẫn còn, kể cả khi ứng dụng đóng giữa chừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写日程时即使 App 意外关闭，已输入的内容也会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填寫行程時即使 App 意外關閉，已輸入的內容也會保留。"
          }
        }
      }
    },
    "일정을 추가할 수 있는 캘린더 계정을 찾지 못했습니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl nalezen žádný účet kalendáře, do kterého lze události přidávat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet en kalenderkonto, som begivenheder kan tilføjes til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein Kalenderaccount gefunden, in den Termine eingetragen werden können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε λογαριασμός ημερολογίου στον οποίο να μπορούν να προστεθούν συμβάντα."
