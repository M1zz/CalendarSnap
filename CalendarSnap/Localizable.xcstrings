    "Face ID나 Touch ID로 앱을 잠가 아이 일정을 지켜요.": {
      "comment": "Roadmap item detail: Face ID lock",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamkněte aplikaci přes Face ID nebo Touch ID a mějte rozvrh dětí v soukromí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås appen med Face ID eller Touch ID, så dine børns skema forbliver privat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperre die App mit Face ID oder Touch ID, damit die Termine deiner Kinder privat bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κλειδώστε την εφαρμογή με Face ID ή Touch ID για να μένει το πρόγραμμα των παιδιών σας ιδιωτικό."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock the app with Face ID or Touch ID to keep your kids’ schedules private."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock the app with Face ID or Touch ID to keep your kids’ schedules private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquea la app con Face ID o Touch ID para mantener privada la agenda de tus hijos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukitse sovellus Face ID:llä tai Touch ID:llä, niin lastesi aikataulut pysyvät yksityisinä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillez l’app avec Face ID ou Touch ID pour garder l’agenda de vos enfants privé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci aplikasi dengan Face ID atau Touch ID agar jadwal anak Anda tetap pribadi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca l’app con Face ID o Touch ID per mantenere privata l’agenda dei tuoi bambini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face IDやTouch IDでアプリをロックして、お子さまの予定を守れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID나 Touch ID로 앱을 잠가 아이 일정을 지켜요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås appen med Face ID eller Touch ID, så barnas planer forblir private."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrendel de app met Face ID of Touch ID zodat de planning van je kinderen privé blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokuj aplikację za pomocą Face ID lub Touch ID, aby plan dzieci pozostał prywatny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueie o app com Face ID ou Touch ID para manter a agenda dos seus filhos privada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокируйте приложение с помощью Face ID или Touch ID, чтобы расписание детей оставалось личным."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås appen med Face ID eller Touch ID så att barnens scheman förblir privata."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล็อกแอปด้วย Face ID หรือ Touch ID เพื่อรักษากำหนดการของลูกให้เป็นส่วนตัว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çocuklarınızın programı gizli kalsın diye uygulamayı Face ID veya Touch ID ile kilitleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa ứng dụng bằng Face ID hoặc Touch ID để giữ lịch của bé luôn riêng tư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Face ID 或 Touch ID 锁定 App，保护孩子的日程隐私。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Face ID 或 Touch ID 鎖定 App，保護孩子行程的隱私。"
          }
        }
      }
    },
    "Siri에게 물어 아이의 오늘 일정을 바로 확인해요.": {
      "comment": "Roadmap item detail: Siri and Shortcuts",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptejte se Siri, co dítě dnes čeká."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Spørg Siri, hvad der står på programmet for dit barn i dag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag Siri, was heute bei deinem Kind ansteht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ρωτήστε τη Siri τι έχει σήμερα το παιδί σας στο πρόγραμμά του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Siri what’s on your child’s schedule today."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Siri what’s on your child’s schedule today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregúntale a Siri qué tiene hoy tu hijo o hija en la agenda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kysy Sirilta, mitä lapsella on tänään ohjelmassa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à Siri ce qui est prévu aujourd’hui pour votre enfant."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanya Siri apa jadwal anak Anda hari ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a Siri cosa c’è oggi in agenda per tuo figlio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siriに聞いて、お子さまの今日の予定をすぐに確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri에게 물어 아이의 오늘 일정을 바로 확인해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spør Siri hva barnet har på programmet i dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag Siri wat je kind vandaag op het programma heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj Siri, co dziecko ma dziś w planie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte à Siri o que seu filho tem hoje na agenda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите Siri, что сегодня в расписании у ребёнка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga Siri vad barnet har på schemat idag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถาม Siri ว่าวันนี้ลูกมีอะไรบ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri’ye sorun, çocuğunuzun bugün neler var?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi Siri xem hôm nay bé có lịch gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问问 Siri，随时了解孩子今天的日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問問 Siri，隨時掌握孩子今天的行程。"
          }
        }
      }
    },
