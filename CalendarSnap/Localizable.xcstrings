    "아이를 등록하면 일정이 아이별로 관리되고 알림에도 이름이 표시돼요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte dítě, aby se události řadily podle dětí a jeho jméno bylo vidět v připomínkách."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj et barn for at sortere begivenheder efter barn og se navnet i påmindelserne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege ein Kind an, damit Termine pro Kind geordnet werden und der Name in den Erinnerungen erscheint."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα παιδί για να οργανώνονται τα συμβάντα ανά παιδί και να εμφανίζεται το όνομά του στις υπενθυμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a child to keep events organized by child and see their name in reminders."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a child to keep events organised by child and see their name in reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade a tu hijo o hija para organizar los eventos por niño y ver su nombre en los recordatorios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää lapsi, niin tapahtumat järjestyvät lapsittain ja nimi näkyy muistutuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un enfant pour classer les événements par enfant et voir son prénom dans les rappels."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan anak agar acara terkelompok per anak dan namanya tampil di pengingat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un bambino per organizzare gli eventi per bambino e vedere il suo nome nei promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さまを登録すると、予定がお子さまごとに管理され、通知にも名前が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이를 등록하면 일정이 아이별로 관리되고 알림에도 이름이 표시돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til et barn for å sortere avtaler per barn og se navnet i påminnelsene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een kind toe om afspraken per kind te ordenen en de naam in herinneringen te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dziecko, aby wydarzenia były uporządkowane według dzieci, a jego imię pojawiało się w przypomnieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadastre uma criança para organizar os eventos por criança e ver o nome nos lembretes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте ребёнка, и события будут храниться по детям, а в напоминаниях появится имя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till ett barn för att sortera händelser per barn och se namnet i påminnelserna."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มเด็กเพื่อจัดกำหนดการแยกตามเด็ก และให้ชื่อแสดงในการแจ้งเตือนด้วย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinliklerin çocuğa göre düzenlenmesi ve hatırlatıcılarda adının görünmesi için bir çocuk ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm bé để sắp xếp sự kiện theo từng bé và hiện tên bé trong lời nhắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加孩子后，日程会按孩子分别管理，提醒里也会显示孩子的名字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增孩子後，行程會依孩子分別管理，提醒中也會顯示孩子的名字。"
          }
        }
      }
    },
    "아이를 등록하면 일정이 아이별로 관리되고 알림에도 이름이 함께 표시돼요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte dítě, aby se události řadily podle dětí a jeho jméno bylo vidět v připomínkách."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj et barn for at sortere begivenheder efter barn og se navnet i påmindelserne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege ein Kind an, damit Termine pro Kind geordnet werden und der Name in den Erinnerungen erscheint."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα παιδί για να οργανώνονται τα συμβάντα ανά παιδί και να εμφανίζεται το όνομά του στις υπενθυμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a child to keep events organized by child and see their name in reminders."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a child to keep events organised by child and see their name in reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade a tu hijo o hija para organizar los eventos por niño y ver su nombre en los recordatorios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää lapsi, niin tapahtumat järjestyvät lapsittain ja nimi näkyy muistutuksissa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un enfant pour classer les événements par enfant et voir son prénom dans les rappels."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan anak agar acara terkelompok per anak dan namanya tampil di pengingat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un bambino per organizzare gli eventi per bambino e vedere il suo nome nei promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お子さまを登録すると、予定がお子さまごとに管理され、通知にも名前が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이를 등록하면 일정이 아이별로 관리되고 알림에도 이름이 함께 표시돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Legg til et barn for å sortere avtaler per barn og se navnet i påminnelsene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een kind toe om afspraken per kind te ordenen en de naam in herinneringen te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dziecko, aby wydarzenia były uporządkowane według dzieci, a jego imię pojawiało się w przypomnieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
