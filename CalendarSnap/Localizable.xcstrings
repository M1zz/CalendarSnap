    "가족 공유가 종료됐어요. 지금까지 받은 일정은 그대로 남아 있어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodinné sdílení skončilo. Dosud přijaté události zůstávají."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiedelingen er afsluttet. Begivenheder, du allerede har modtaget, bliver liggende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Familienfreigabe ist beendet. Bereits erhaltene Termine bleiben erhalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η οικογενειακή κοινή χρήση τερματίστηκε. Τα συμβάντα που έχετε ήδη λάβει παραμένουν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family sharing has ended. Events you’ve received so far stay as they are."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Family sharing has ended. Events you’ve received so far stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha terminado el grupo familiar. Los eventos recibidos hasta ahora se conservan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Perhejako on päättynyt. Jo vastaanotetut tapahtumat säilyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage familial est terminé. Les événements déjà reçus sont conservés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbagi keluarga telah berakhir. Acara yang sudah diterima tetap tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La condivisione familiare è terminata. Gli eventi già ricevuti restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "家族共有が終了しました。これまでに受け取った予定はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족 공유가 종료됐어요. 지금까지 받은 일정은 그대로 남아 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Familiedelingen er avsluttet. Avtaler du allerede har mottatt, blir værende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezinsdeling is beëindigd. Afspraken die je al hebt ontvangen, blijven bestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnianie rodzinne zakończyło się. Dotychczas otrzymane wydarzenia zostają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compartilhamento familiar terminou. Os eventos já recebidos continuam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семейный доступ завершён. Полученные события остаются на месте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Familjedelningen har tagit slut. Händelser du redan fått finns kvar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแชร์ครอบครัวสิ้นสุดแล้ว กำหนดการที่ได้รับมาแล้วจะยังคงอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aile paylaşımı sona erdi. Şimdiye kadar aldığınız etkinlikler olduğu gibi kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ gia đình đã kết thúc. Các sự kiện đã nhận vẫn được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家庭共享已结束。目前收到的日程会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "家庭共享已結束。目前收到的行程會保留。"
          }
        }
      }
    },
    "가족 공유를 중단했어요. 지금까지의 일정은 그대로 남아 있어요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
