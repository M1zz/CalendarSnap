    "일정 패턴을 보고 '%@'의 문서로 인식했어요. 아니라면 위에서 바꿔주세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podle událostí to vypadá na dokument dítěte %@. Pokud ne, změňte to výše."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ud fra begivenhederne ser det ud til at være %@s dokument. Hvis ikke, så ændr det ovenfor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach den Terminen zu urteilen, gehört das zu %@. Falls nicht, ändere das oben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από τα συμβάντα, φαίνεται ότι είναι το έγγραφο του/της %@. Αν όχι, αλλάξτε το παραπάνω."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on the events, this looks like %@’s document. If not, change it above."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on the events, this looks like %@’s document. If not, change it above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por los eventos, parece el documento de %@. Si no es así, cámbialo arriba."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtumien perusteella tämä näyttää lapsen %@ asiakirjalta. Jos ei, vaihda se yltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’après les événements, il s’agit du document de %@. Sinon, modifiez-le ci-dessus."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari acaranya, ini tampaknya dokumen milik %@. Jika bukan, ubah di atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In base agli eventi, sembra il documento di %@. Se non è così, cambialo qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定の内容から、%@のプリントと判断しました。違う場合は上で変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정 패턴을 보고 '%@'의 문서로 인식했어요. 아니라면 위에서 바꿔주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ut fra avtalene ser dette ut som %@ sitt dokument. Hvis ikke, endrer du det ovenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op basis van de afspraken lijkt dit het document van %@. Zo niet, wijzig het dan hierboven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na podstawie wydarzeń wygląda to na dokument dziecka: %@. Jeśli nie, zmień to powyżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelos eventos, parece ser o documento de %@. Se não for, altere acima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Судя по событиям, это документ для ребёнка: %@. Если это не так, измените выше."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utifrån händelserna ser det ut som %@s dokument. Om inte, ändra det ovan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จากกำหนดการ ดูเหมือนเป็นเอกสารของ %@ หากไม่ใช่ ให้เปลี่ยนด้านบน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinliklere bakılırsa bu, %@ çocuğuna ait bir belge gibi görünüyor. Değilse yukarıdan değiştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dựa vào các sự kiện, đây có vẻ là tài liệu của %@. Nếu không đúng, hãy đổi ở trên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据日程内容，这看起来是 %@ 的文件。如果不对，请在上方更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據行程內容，這看起來是 %@ 的文件。若不是，請在上方更改。"
          }
        }
      }
    },
    "일정으로 인식할 텍스트를 찾지 못했습니다.\n글씨가 선명하게 나오도록 다시 찍어보세요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nebyl nalezen žádný text, který by vypadal jako události.\nVyfoťte to znovu tak, aby bylo písmo ostré."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev ikke fundet tekst, der ligner begivenheder.\nTag billedet igen, så skriften er skarp."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein Text gefunden, der nach Terminen aussieht.\nMach das Foto bitte noch einmal, sodass die Schrift gut lesbar ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε κείμενο που να μοιάζει με συμβάντα.\nΤραβήξτε ξανά τη φωτογραφία ώστε τα γράμματα να είναι καθαρά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t find any text that looks like events.\nTry taking the photo again so the writing is sharp."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t find any text that looks like events.\nTry taking the photo again so the writing is sharp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró texto que parezca eventos.\nVuelve a hacer la foto para que se lea bien."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapahtumilta näyttävää tekstiä ei löytynyt.\nOta kuva uudelleen niin, että teksti on terävää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun texte ressemblant à des événements n’a été trouvé.\nReprenez la photo pour que l’écriture soit bien nette."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ditemukan teks yang tampak seperti acara.\nCoba foto lagi agar tulisannya jelas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato trovato testo che somigli a degli eventi.\nRiprova a scattare la foto in modo che la scrittura sia nitida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定として読み取れる文字が見つかりませんでした。\n文字がはっきり写るように撮り直してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정으로 인식할 텍스트를 찾지 못했습니다.\n글씨가 선명하게 나오도록 다시 찍어보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen tekst som ser ut som avtaler.\nTa bildet på nytt, slik at skriften blir skarp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen tekst gevonden die op afspraken lijkt.\nMaak de foto opnieuw, zodat de tekst scherp is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono tekstu przypominającego wydarzenia.\nZrób zdjęcie jeszcze raz, tak aby tekst był wyraźny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi encontrado nenhum texto que pareça um evento.\nTire a foto de novo, de modo que a escrita fique nítida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти текст, похожий на события.\nСфотографируйте ещё раз так, чтобы текст был чётким."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hittade ingen text som liknar händelser.\nTa om bilden så att texten blir skarp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบข้อความที่ดูเป็นกำหนดการ\nลองถ่ายรูปใหม่ให้ตัวอักษรคมชัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinliğe benzeyen bir metin bulunamadı.\nYazılar net çıksın diye fotoğrafı yeniden çekin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy văn bản nào giống sự kiện.\nHãy chụp lại để chữ rõ nét hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到可识别为日程的文字。\n请重新拍摄，让字迹更清晰。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到可辨識為行程的文字。\n請重新拍攝，讓字跡更清楚。"
          }
        }
      }
    },
    "일정을 넣거나 저장했을 때 가볍게 떨려서 알려 줘요.": {
      "comment": "Roadmap item detail: haptic feedback",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemné cuknutí vám dá vědět, že se událost přidala nebo uložila."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et let tryk fortæller dig, når en begivenhed er tilføjet eller gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanftes Tippen zeigt dir, wenn ein Termin hinzugefügt oder gesichert wurde."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ένα ελαφρύ χτύπημα σάς ειδοποιεί όταν προστίθεται ή αποθηκεύεται ένα συμβάν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle tap lets you know when an event is added or saved."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle tap lets you know when an event is added or saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque suave te avisa cuando se añade o guarda un evento."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kevyt tärinä kertoo, kun tapahtuma on lisätty tai tallennettu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une légère vibration vous prévient quand un événement est ajouté ou enregistré."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Getaran lembut memberi tahu saat acara ditambahkan atau disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lieve tocco ti avvisa quando un evento viene aggiunto o salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を追加・保存したとき、軽い振動でお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정을 넣거나 저장했을 때 가볍게 떨려서 알려 줘요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et lett trykk gir beskjed når en avtale er lagt til eller lagret."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een zacht tikje laat je weten wanneer een afspraak is toegevoegd of bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delikatne stuknięcie informuje, gdy wydarzenie zostanie dodane lub zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque suave avisa quando um evento é adicionado ou salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёгкая вибрация сообщит, что событие добавлено или сохранено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En lätt vibration visar när en händelse har lagts till eller sparats."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สั่นเบา ๆ เมื่อเพิ่มหรือบันทึกกำหนดการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir etkinlik eklendiğinde ya da kaydedildiğinde hafif bir titreşim sizi bilgilendirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rung nhẹ để báo khi sự kiện được thêm hoặc lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
