      }
    },
    "펼치는 아이폰에서 달력과 일정을 두 쪽으로 나눠 봐요.": {
      "comment": "Roadmap item detail: foldable iPhone layout",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the calendar and events side by side on a foldable iPhone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "See the calendar and events side by side on a foldable iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみ式iPhoneで、カレンダーと予定を2画面に並べて見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펼치는 아이폰에서 달력과 일정을 두 쪽으로 나눠 봐요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在折叠屏 iPhone 上，日历和日程左右并排显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在摺疊式 iPhone 上，行事曆與行程左右並排顯示。"
          }
        }
      }
    },
    "한 달 일정을 자동으로 추출해\n캘린더에 한 번에 추가하고 알림을 보내드려요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll pull out the whole month’s events,\nadd them to your calendar at once, and remind you."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll pull out the whole month’s events,\nadd them to your calendar at once, and remind you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1か月分の予定を自動で読み取り、\nカレンダーにまとめて追加して、通知でお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 달 일정을 자동으로 추출해\n캘린더에 한 번에 추가하고 알림을 보내드려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动提取整月日程，\n一次添加到日历，并按时提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動擷取整個月的行程，\n一次加入行事曆，並準時提醒你。"
          }
        }
      }
    },
