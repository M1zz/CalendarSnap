    "펼치는 아이폰에서 달력과 일정을 두 쪽으로 나눠 봐요.": {
      "comment": "Roadmap item detail: foldable iPhone layout",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendář a události vedle sebe na skládacím iPhonu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se kalender og begivenheder side om side på en foldbar iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalender und Termine nebeneinander auf einem faltbaren iPhone."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δείτε το ημερολόγιο και τα συμβάντα δίπλα-δίπλα σε αναδιπλούμενο iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See the calendar and events side by side on a foldable iPhone."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "See the calendar and events side by side on a foldable iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira el calendario y los eventos lado a lado en un iPhone plegable."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näe kalenteri ja tapahtumat rinnakkain taitettavalla iPhonella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez le calendrier et les événements côte à côte sur un iPhone pliable."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat kalender dan acara berdampingan di iPhone lipat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedi calendario ed eventi affiancati su un iPhone pieghevole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "折りたたみ式iPhoneで、カレンダーと予定を2画面に並べて見られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펼치는 아이폰에서 달력과 일정을 두 쪽으로 나눠 봐요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se kalenderen og avtalene side om side på en sammenleggbar iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk de agenda en afspraken naast elkaar op een opvouwbare iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz kalendarz i wydarzenia obok siebie na składanym iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o calendário e os eventos lado a lado em um iPhone dobrável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На складном iPhone календарь и события показываются рядом."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se kalendern och händelserna sida vid sida på en vikbar iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูปฏิทินและกำหนดการเคียงข้างกันบน iPhone แบบพับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katlanabilir iPhone’da takvimi ve etkinlikleri yan yana görün."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lịch và sự kiện cạnh nhau trên iPhone gập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在折叠屏 iPhone 上，日历和日程左右并排显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在摺疊式 iPhone 上，行事曆與行程左右並排顯示。"
          }
        }
      }
    },
    "한 달 일정을 자동으로 추출해\n캘린더에 한 번에 추가하고 알림을 보내드려요.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytáhneme všechny události měsíce,\nnajednou je přidáme do kalendáře a připomeneme je."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi finder alle månedens begivenheder,\ntilføjer dem til din kalender på én gang og minder dig om dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir lesen alle Termine des Monats aus,\ntragen sie auf einmal in deinen Kalender ein und erinnern dich daran."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα εξάγουμε όλα τα συμβάντα του μήνα,\nθα τα προσθέσουμε στο ημερολόγιο με μία κίνηση και θα σας τα υπενθυμίζουμε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll pull out the whole month’s events,\nadd them to your calendar at once, and remind you."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll pull out the whole month’s events,\nadd them to your calendar at once, and remind you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sacaremos todos los eventos del mes,\nlos añadiremos al calendario de una vez y te avisaremos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poimimme koko kuukauden tapahtumat,\nlisäämme ne kalenteriin kerralla ja muistutamme niistä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous repérons tous les événements du mois,\nles ajoutons d’un coup à votre calendrier et vous les rappelons."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan mengambil semua acara sebulan,\nmenambahkannya ke kalender sekaligus, dan mengingatkan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estraiamo tutti gli eventi del mese,\nli aggiungiamo al calendario in un colpo solo e ti ricordiamo ogni cosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1か月分の予定を自動で読み取り、\nカレンダーにまとめて追加して、通知でお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 달 일정을 자동으로 추출해\n캘린더에 한 번에 추가하고 알림을 보내드려요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi henter ut alle avtalene i måneden,\nlegger dem inn i kalenderen på én gang og minner deg på dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We halen alle afspraken van de maand eruit,\nzetten ze in één keer in je agenda en herinneren je eraan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyciągniemy wszystkie wydarzenia miesiąca,\ndodamy je do kalendarza za jednym razem i przypomnimy o nich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos extrair os eventos do mês inteiro,\nadicioná-los ao calendário de uma vez e avisar você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы найдём все события месяца,\nодним махом добавим их в календарь и напомним о них."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi hämtar alla månadens händelser,\nlägger in dem i kalendern på en gång och påminner dig om dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะดึงกำหนดการทั้งเดือนให้\nเพิ่มลงปฏิทินในครั้งเดียว และแจ้งเตือนให้คุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayın tüm etkinliklerini çıkaracak,\ntakvime tek seferde ekleyecek ve size hatırlatacağız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ trích xuất mọi sự kiện trong tháng,\nthêm vào lịch một lần và nhắc bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动提取整月日程，\n一次添加到日历，并按时提醒你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動擷取整個月的行程，\n一次加入行事曆，並準時提醒你。"
          }
        }
      }
    },
