    "켜면 %@ 달력에 일정이 등록돼요. iOS 캘린더 앱에서 해당 달력을 ‘공유’하면 배우자·가족과 자동으로 동기화됩니다.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je zapnuto, události se přidávají do kalendáře „%@“. Sdílejte tento kalendář v aplikaci Kalendář v iOS a bude se automaticky synchronizovat s partnerem a rodinou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når det er slået til, tilføjes begivenhederne til kalenderen “%@”. Del den kalender i iOS-appen Kalender for at holde den synkroniseret med partner og familie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden Termine im Kalender „%@“ eingetragen. Gib diesen Kalender in der iOS-Kalender-App frei, damit er automatisch mit Partner und Familie synchron bleibt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όταν είναι ενεργό, τα συμβάντα προστίθενται στο ημερολόγιο «%@». Μοιραστείτε αυτό το ημερολόγιο στην εφαρμογή Ημερολόγιο του iOS ώστε να συγχρονίζεται με το/τη σύντροφο και την οικογένεια."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, events are added to the %@ calendar. Share that calendar in the iOS Calendar app to keep it in sync with your partner and family."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, events are added to the %@ calendar. Share that calendar in the iOS Calendar app to keep it in sync with your partner and family."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo activas, los eventos se añaden al calendario %@. Comparte ese calendario en la app Calendario de iOS para mantenerlo sincronizado con tu pareja y tu familia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun päällä, tapahtumat lisätään kalenteriin ”%@”. Jaa kyseinen kalenteri iOS:n Kalenteri-sovelluksessa, niin se pysyy synkronoituna puolison ja perheen kanssa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activé, les événements sont ajoutés au calendrier « %@ ». Partagez ce calendrier dans l’app Calendrier d’iOS pour le synchroniser avec votre conjoint et votre famille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika aktif, acara ditambahkan ke kalender “%@”. Bagikan kalender itu di aplikasi Kalender iOS agar tersinkron otomatis dengan pasangan dan keluarga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, gli eventi vengono aggiunti al calendario «%@». Condividi quel calendario nell’app Calendario di iOS per mantenerlo sincronizzato con il partner e la famiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、予定が「%@」カレンダーに登録されます。iOSの「カレンダー」Appでこのカレンダーを共有すると、配偶者や家族と自動で同期できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 %@ 달력에 일정이 등록돼요. iOS 캘린더 앱에서 해당 달력을 ‘공유’하면 배우자·가족과 자동으로 동기화됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når dette er på, legges avtalene til i kalenderen «%@». Del den kalenderen i Kalender-appen i iOS for å holde den synkronisert med partner og familie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als dit aanstaat, worden afspraken toegevoegd aan de agenda ‘%@’. Deel die agenda in de iOS-app Agenda om hem automatisch te synchroniseren met je partner en gezin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy włączone, wydarzenia są dodawane do kalendarza „%@”. Udostępnij ten kalendarz w aplikacji Kalendarz w iOS, aby synchronizował się z partnerem i rodziną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ativado, os eventos são adicionados ao calendário “%@”. Compartilhe esse calendário no app Calendário do iOS para manter tudo sincronizado com o cônjuge e a família."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, события попадут в календарь «%@». Откройте общий доступ к нему в приложении «Календарь» на iOS, и он автоматически синхронизируется с партнёром и семьёй."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När det är på läggs händelserna till i kalendern ”%@”. Dela den kalendern i appen Kalender i iOS för att hålla den synkad med partner och familj."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเปิด กำหนดการจะถูกเพิ่มลงปฏิทิน “%@” แชร์ปฏิทินนั้นในแอปปฏิทินของ iOS เพื่อซิงค์กับคู่สมรสและครอบครัวโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıkken etkinlikler “%@” takvimine eklenir. Eşiniz ve ailenizle otomatik eşitlenmesi için bu takvimi iOS Takvim uygulamasında paylaşın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, sự kiện được thêm vào lịch “%@”. Hãy chia sẻ lịch đó trong ứng dụng Lịch của iOS để tự động đồng bộ với vợ/chồng và gia đình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，日程会添加到 %@ 日历。在 iOS“日历”App 中共享该日历，即可与伴侣和家人自动同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，行程會加入 %@ 行事曆。在 iOS「行事曆」App 中共享該行事曆，即可與另一半和家人自動同步。"
          }
        }
      }
    },
