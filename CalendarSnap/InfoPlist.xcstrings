    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je potřeba přístup ke kalendáři, aby bylo možné přidat vyčtené události ze školky a kontrolovat duplicity."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Adgang til kalenderen er nødvendig for at tilføje de udtrukne begivenheder fra børnehaven og tjekke for dubletter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalenderzugriff wird benötigt, um die ausgelesenen Kita-Termine einzutragen und Duplikate zu erkennen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απαιτείται πρόσβαση στο ημερολόγιο για να προστεθούν τα συμβάντα του παιδικού σταθμού που εξήχθησαν και να ελεγχθούν τα διπλότυπα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is needed to add the extracted daycare events to your calendar and check for duplicates."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is needed to add the extracted nursery events to your calendar and check for duplicates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita acceso al calendario para añadir los eventos de la guardería y comprobar si están duplicados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au calendrier est nécessaire pour ajouter les événements extraits de la crèche et repérer les doublons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve l’accesso al calendario per aggiungere gli eventi del nido estratti e controllare i duplicati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取った保育園の予定をカレンダーに追加し、重複を確認するために、カレンダーへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추출한 어린이집 일정을 캘린더에 추가하고 중복을 확인하기 위해 캘린더 접근이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao calendário é necessário para adicionar os eventos extraídos da escolinha e checar duplicados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен доступ к календарю, чтобы добавлять найденные события детского сада и проверять повторы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องเข้าถึงปฏิทินเพื่อเพิ่มกำหนดการของโรงเรียนที่ดึงมา และตรวจสอบรายการซ้ำ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần truy cập Lịch để thêm các sự kiện của trường đã trích xuất và kiểm tra trùng lặp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要访问日历，以便将提取的幼儿园日程添加到日历并检查是否重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要存取行事曆，以便將擷取的幼兒園行程加入行事曆並檢查是否重複。"
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je potřeba přístup ke kalendáři, aby bylo možné přidat vyčtené události ze školky."
