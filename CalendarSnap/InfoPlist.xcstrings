            "state": "translated",
            "value": "こどもスケジュール"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이일정"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расписание малыша"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宝贝日程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寶貝日程"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is needed to add the extracted daycare events to your calendar and check for duplicates."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is needed to add the extracted nursery events to your calendar and check for duplicates."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取った保育園の予定をカレンダーに追加し、重複を確認するために、カレンダーへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추출한 어린이집 일정을 캘린더에 추가하고 중복을 확인하기 위해 캘린더 접근이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен доступ к календарю, чтобы добавлять найденные события детского сада и проверять повторы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要访问日历，以便将提取的幼儿园日程添加到日历并检查是否重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要存取行事曆，以便將擷取的幼兒園行程加入行事曆並檢查是否重複。"
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is needed to add the extracted daycare events to your calendar."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is needed to add the extracted nursery events to your calendar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取った保育園の予定をカレンダーに追加するために、カレンダーへのアクセスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추출한 어린이집 일정을 캘린더에 추가하기 위해 캘린더 접근이 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен доступ к календарю, чтобы добавлять найденные события детского сада."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要访问日历，以便将提取的幼儿园日程添加到日历。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要存取行事曆，以便將擷取的幼兒園行程加入行事曆。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to take photos of calendars and extract events."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to take photos of calendars and extract events."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーの写真を撮影して予定を読み取るために、カメラを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력 사진을 찍어 일정을 추출하기 위해 카메라를 사용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера нужна, чтобы фотографировать календари и находить в них события."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相机拍摄日历照片以提取日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相機拍攝行事曆照片以擷取行程。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
