    },
    "NSCameraUsageDescription": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoaparát slouží k focení kalendářů a vyčítání událostí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraet bruges til at tage billeder af kalendere og udtrække begivenheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird verwendet, um Kalender zu fotografieren und Termine auszulesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κάμερα χρησιμοποιείται για να φωτογραφίζετε ημερολόγια και να εξάγονται συμβάντα."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to take photos of calendars and extract events."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to take photos of calendars and extract events."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se usa para hacer fotos de calendarios y extraer los eventos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo sert à photographier les calendriers et à en extraire les événements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera serve per fotografare i calendari ed estrarne gli eventi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーの写真を撮影して予定を読み取るために、カメラを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "달력 사진을 찍어 일정을 추출하기 위해 카메라를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera é usada para fotografar calendários e extrair os eventos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера нужна, чтобы фотографировать календари и находить в них события."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กล้องถ่ายรูปปฏิทินเพื่อดึงกำหนดการ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera được dùng để chụp lịch và trích xuất sự kiện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相机拍摄日历照片以提取日程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相機拍攝行事曆照片以擷取行程。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
